# lists of files to be considered by our linters
FORMAT_TARGETS= \
    cdedb/backend/ \
    cdedb/cli/ \
    cdedb/common/ \
    cdedb/database/ \
    cdedb/fee_condition_parser/ \
    cdedb/frontend/assembly/ \
    cdedb/frontend/cde/ \
    cdedb/frontend/core/complaint.py \
    cdedb/frontend/ml/ \
    cdedb/frontend/*.py \
    cdedb/ldap/ \
    cdedb/models/ \
    cdedb/uncommon/ \
    cdedb/*.py \
    tests/backend_tests/complaint.py \
    tests/frontend_tests/complaint.py
LINT_TARGETS=cdedb tests
ISORT_TARGETS=bin/*.py cdedb tests
