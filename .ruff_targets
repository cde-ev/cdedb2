# lists of files to be considered by our linters
FORMAT_TARGETS= \
    cdedb/backend/ \
    cdedb/cli/ \
    cdedb/common/ \
    cdedb/database/ \
    cdedb/fee_condition_parser/ \
    cdedb/frontend/assembly/ \
    cdedb/frontend/cde/ \
    cdedb/frontend/core/complaint.py \
    cdedb/frontend/event/__init__.py \
    cdedb/frontend/event/base.py \
    cdedb/frontend/event/course.py \
    cdedb/frontend/event/download.py \
    cdedb/frontend/event/droid.py \
    cdedb/frontend/event/event.py \
    cdedb/frontend/event/lodgement.py \
    cdedb/frontend/event/lodgement_wishes.py \
    cdedb/frontend/event/partial_import.py \
    cdedb/frontend/event/query.py \
    cdedb/frontend/event/query_stats.py \
    cdedb/frontend/ml/ \
    cdedb/frontend/*.py \
    cdedb/ldap/ \
    cdedb/models/ \
    cdedb/uncommon/ \
    cdedb/*.py \
    tests/backend_tests/complaint.py \
    tests/frontend_tests/complaint.py
LINT_TARGETS=cdedb tests
ISORT_TARGETS=bin/*.py cdedb tests
