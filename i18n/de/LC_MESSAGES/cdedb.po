msgid "This is a very common password."
msgstr "Das ist ein sehr häufiges Passwort."

#: cdedb/.i18n_additional.py:475 cdedb/i18n_additional.py:106
msgid "This is similar to a commonly used password."
msgstr "Das ist ähnlich zu einem häufig genutzten Passwort."

#: cdedb/.i18n_additional.py:476 cdedb/i18n_additional.py:107
msgid "A word by itself is easy to guess."
msgstr "Ein einzelnes Wort ist einfach zu erraten."

#: cdedb/.i18n_additional.py:477 cdedb/i18n_additional.py:108
