msgid "Event Data"
msgstr "Veranstaltungs-Daten"

#: cdedb/frontend/templates/web/core/show_user_events.tmpl:28
msgid ""
"This lists all events which have not been deleted yet and this user has a "
"registration for."
msgstr ""
"Diese Liste enthält alle Veranstaltungen, die noch nicht gelöscht wurden und "
"für die dieser Nutzer eine Anmeldung hat."

#: cdedb/frontend/templates/web/core/show_user_events.tmpl:54
msgid "This user has no registrations."
msgstr "Dieser Nutzer hat keine Anmeldungen."

