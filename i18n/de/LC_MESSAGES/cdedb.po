#: cdedb/frontend/templates/web/assembly/ballot/_ballot_meta.tmpl:136
msgid ""
"All CdE-Members and external assembly participants can already see this "
"ballot and all associated information."
msgstr ""
"Alle CdE-Mitglieder und externe Teilnehmer der Versammlung können die "
"Abstimmung und alle Details jedoch bereits jetzt sehen, um sich zu "
"informieren."

#: cdedb/frontend/templates/web/assembly/ballot/_ballot_meta.tmpl:142
msgid "This ballot has been concluded."
msgstr "Die Abstimmung ist beendet."

#: cdedb/frontend/templates/web/assembly/ballot/_ballot_meta.tmpl:143
