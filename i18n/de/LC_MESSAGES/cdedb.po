#: cdedb/frontend/templates/web/assembly/ballot/_ballot_tallied.tmpl:13
msgid "Pro-Votes"
msgstr "Pro-Stimmen"

#: cdedb/frontend/templates/web/assembly/ballot/_ballot_tallied.tmpl:17
msgid "Contra-Votes"
msgstr "Kontra-Stimmen"

#: cdedb/frontend/templates/web/assembly/ballot/_ballot_tallied.tmpl:65
#: cdedb/frontend/templates/web/assembly/ballot/_ballot_tallied.tmpl:173
