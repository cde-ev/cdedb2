#: cdedb/i18n_additional.py:445
msgid "Use a few words, avoid common phrases."
msgstr "Compluribus verbis neque seriebus utatis utaris."

#: cdedb/i18n_additional.py:446
msgid "No need for symbols, digits, or uppercase letters."
msgstr "Notas symbolicas numericasque atque litteras maiores uti non opus est."

#: cdedb/i18n_additional.py:447
msgid "Add another word or two. Uncommon words are better."
msgstr "Verba adderis. Verba inusitata melius sunt."

#: cdedb/i18n_additional.py:448
msgid "Straight rows of keys are easy to guess."
msgstr "Multi propinqui malleoli facile coniectari possunt."

#: cdedb/i18n_additional.py:449
msgid "Short keyboard patterns are easy to guess."
msgstr "Formula parva malleolorum facile coniectari possunt."

#: cdedb/i18n_additional.py:450
msgid "Use a longer keyboard pattern with more turns."
msgstr "Maiore formula malleolorum pluribus cum conversionibus utaris."

#: cdedb/i18n_additional.py:451
msgid "Repeats like \"aaa\" are easy to guess."
msgstr "Repetitiones ut „aaa“ facile coniectari possunt."

#: cdedb/i18n_additional.py:452
msgid ""
"Repeats like \"abcabcabc\" are only slightly harder to guess than \"abc\"."
msgstr ""
"Repetitiones ut „abcabcabc“ paulo tantum difficilius quam „abc“ coniectari "
"possunt."

#: cdedb/i18n_additional.py:454
msgid "Avoid repeated words and characters."
msgstr "Verba notaeque repetere vites."

#: cdedb/i18n_additional.py:455
msgid "Sequences like \"abc\" or \"6543\" are easy to guess."
msgstr "Series ut „abc“ aut „6543“ facile coniectari possunt."

#: cdedb/i18n_additional.py:456
msgid "Avoid sequences."
msgstr "Series vites."

#: cdedb/i18n_additional.py:457
msgid "Recent years are easy to guess."
msgstr "Anni recentes facile coniectari possunt."

#: cdedb/i18n_additional.py:458
msgid "Avoid recent years."
msgstr "Annos recentes vites."

#: cdedb/i18n_additional.py:459
msgid "Avoid years that are associated with you."
msgstr "Annos tibi coniunctos vites."

#: cdedb/i18n_additional.py:460
msgid "Avoid dates and years that are associated with you."
msgstr "Annos diesque tibi coniunctos vites."

#: cdedb/i18n_additional.py:461
msgid "This is a top-10 common password."
msgstr "Hoc unum decem sigorum arcanorum frequentissime usorum est."

#: cdedb/i18n_additional.py:462
msgid "This is a top-100 common password."
msgstr "Hoc unum centum sigorum arcanorum frequentissime usorum est."

#: cdedb/i18n_additional.py:463
msgid "This is a very common password."
msgstr "Hoc signum arcanum frequentissime usum est."

#: cdedb/i18n_additional.py:464
msgid "This is similar to a commonly used password."
msgstr "Hoc uni signorum arcanorum frequenter usorum simile est."

#: cdedb/i18n_additional.py:465
msgid "A word by itself is easy to guess."
msgstr "Verbum singulare facile coniectari potest."

#: cdedb/i18n_additional.py:466
msgid "Names and surnames by themselves are easy to guess."
msgstr "nomina singulara facile coniectari possunt."

#: cdedb/i18n_additional.py:467
msgid "Common names and surnames are easy to guess."
msgstr "nomina frequenta facile coniectari possunt."

#: cdedb/i18n_additional.py:468
msgid "Capitalization doesn't help very much."
msgstr "Litteras maiores scribere non utillimum est."

#: cdedb/i18n_additional.py:469
msgid "All-uppercase is almost as easy to guess as all-lowercase."
msgstr ""
"Solae litterae maiores paene tanto facile quanto solae litterae minores "
"coniectari possunt."

#: cdedb/i18n_additional.py:470
msgid "Reversed words aren't much harder to guess."
msgstr "Verba circumagere non utillimum est."

#: cdedb/i18n_additional.py:471
msgid ""
"Predictable substitutions like \"@\" instead of \"a\" don't help very much."
msgstr ""
"Notas sic substituere, ut provideri possint (exempli causa „@“ pro „a“), non "
"utillimum est."

