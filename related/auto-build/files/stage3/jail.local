[cdedb-login]
enabled = true
backend = systemd
port    = http,https
filter  = cdedb-login
maxretry = 42

[cdedb-sessionkey]
enabled = true
backend = systemd
port    = http,https
filter  = cdedb-sessionkey
maxretry = 5

[cdedb-apitoken]
enabled = true
backend = systemd
port    = http,https
filter  = cdedb-apitoken
maxretry = 5

[cdedb-contact]
enabled = false
backend = systemd
port    = http,https
filter  = cdedb-contact
maxretry = 5

[cdedb-password-reset]
enabled = true
backend = systemd
port    = http,https
filter  = cdedb-password-reset
maxretry = 10
