# /etc/systemd/system/cdedb-app.service
[Unit]
Description=CdEDB Application server
Requires=cdedb-app.socket
After=network.target

[Service]
Type=notify
User=www-cde
Group=www-data
RuntimeDirectory=gunicorn
WorkingDirectory=/cdedb2
Environment="SCRIPT_NAME=/db"
ExecStart=/home/www-cde/.venv/bin/gunicorn \
    --forwarded-allow-ips="*" -w 4 -t 90 \
    --limit-request-line 0 --limit-request-fields 0 \
    wsgi.cdedb-app:application
ExecStartPre=+make -C /cdedb2 www-cde-venv
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
TimeoutStartSec=300
PrivateTmp=true
