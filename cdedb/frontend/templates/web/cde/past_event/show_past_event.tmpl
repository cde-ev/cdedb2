{% set sidenav_active='cde_past_events' %}
{% extends "web/cde/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}
{% import "web/cde/past_event/generic.tmpl" as generic with context %}

{% if "past_event" in user.admin_views %}
    {% set jshint='weak' %}
    {% block scripts %}
        {{ util.cdedb_script('cdedb_searchpersona.js') }}
        {{ util.cdedb_script('cdedb_helper.js') }}
    {% endblock %}
{% endif %}

{% block title %}{{ ambience['pevent']['title'] }}{% endblock %}
{% block heading %}
    <h1 class="title">{{ ambience['pevent']['title'] }}</h1>
{% endblock %}
{% block breadcrumb %}
    {{ super() }}
    {{ util.breadcrumb_link(cdedblink("cde/list_past_events"), gettext("Past Events")) }}
    {{ util.breadcrumb_link(cdedblink("cde/list_past_events", {"institution": ambience['pevent']['institution']}),
                            gettext(ambience['pevent']['institution'].shortname)) }}
    {{ util.breadcrumb_link(cdedblink("cde/show_past_event", {"pevent_id": ambience['pevent']['id']}),
            ambience['pevent']['title'], icon="calendar-alt", active=True) }}
{% endblock %}

{% block content %}
    {% if "past_event" in user.admin_views %}
        <div class="p">
        {{ util.href(cdedblink('cde/change_past_event_form'), gettext("Edit"), icon="pen",
                aclass="btn btn-warning btn-sm") }}
        </div>
    {% endif %}
    <dl class="dl-horizontal">
        {% if "past_event" in user.admin_views %}
            <dt title="{% trans %}Shortname{% endtrans %}">{% trans %}Shortname{% endtrans %}</dt>
            <dd id="shortname">{{ ambience['pevent']['shortname'] }}</dd>
            <dt title="{% trans %}Cutoff date{% endtrans %}">{% trans %}Cutoff date{% endtrans %}</dt>
            <dd id="cutoff">{{ ambience['pevent']['tempus']|date(lang=lang) }}</dd>
        {% endif %}
        <dt title="{% trans %}Institution{% endtrans %}">
            {% trans %}Institution{% endtrans %}
        </dt>
        <dd id="institution">{{ gettext(ambience['pevent']['institution']|string) }}</dd>
        {% if orgas %}
        <dt title="{% trans %}Orgas{% endtrans %}">
            {% trans %}Orgas{% endtrans %}
        </dt>
        <dd id="orgas">
            {% for orga in orgas %} {# This is already sorted. #}
                {{ generic.print_persona(orga.persona) }}
                {% if not loop.last %},{% endif %}
            {% endfor %}
        </dd>
        {% endif %}
    </dl>

    <div id="description">
        {{ ambience['pevent']['description']|md }}
    </div>
    {% if ambience['pevent']['description'] and ambience['pevent']['participant_info']%}
    <hr />
    {% endif %}
    {% if ambience['pevent']['participant_info'] and ("past_event" in user.admin_views or user.persona_id in participants) %}
        {% if "past_event" in user.admin_views and user.persona_id not in participants %}
            <p class="text-info" id="gallery-admin-info">{{ util.make_icon('info-circle') }}
                {% trans %}
                    As you are no participant of this past event, you can only
                    see this link because you are admin.
                {% endtrans %}
            </p>
        {% endif %}
       <div id="gallery-link">{{ ambience['pevent']['participant_info']|md }}</div>
    {% endif %}
    {% if courses or "past_event" in user.admin_views %}
        {% call util.h(n_("Courses"), level=2) %}
            [{{ courses|length }}]
        {% endcall %}
    {% endif %}
    {% if "past_event" in user.admin_views %}
        <div class="p">
            {{ util.href(cdedblink('cde/create_past_course_form'), gettext("Add Course"), icon="plus",
                    aclass="btn btn-success btn-sm") }}
        </div>
    {% endif %}
    {% if courses %}
        <ul id="list-courses">
            {% for course in courses.values() %}
                <li>
                    {{ course['nr'] }}.
                    {{ util.href(cdedblink('cde/show_past_course', {'pcourse_id' : course.id}), course.title) }}
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {% call util.h(n_("Participants"), level=2) %}
        [{{ total_participant_number }}]
    {% endcall %}
    {% if "past_event" in user.admin_views %}
        <div class="panel panel-success panel-condensed">
            <div class="panel-heading">
                <h4 class="panel-title">{{util.make_icon('plus') }} {% trans %}Add Participant <u>without</u> Course{% endtrans %}</h4>
            </div>
            <div class="panel-body">
                <form action="{{ cdedblink('cde/set_participants') }}" method="POST" id="addparticipantform">
                    {{ util.anti_csrf_token('cde/set_participants') }}
                    <div class="row">
                        <div class="col-sm-6 {% if 'persona_ids' in errors %}has-error{% endif %}">
                            {% call util.output_errors('persona_ids') %}
                                {{ util.input_text(name="persona_ids", placeholder="DB-XXXX-X,DB-XXXX-X,…",
                                                   anid='input-add-participant', aclass='form-control input-sm',
                                                   arialabel=gettext("ID of the new Participant")) }}
                                <script nonce="{{ csp_nonce }}">
                                    $('#input-add-participant').cdedbSearchPerson(
                                        '{{ cdedblink('core/select_persona') }}', {'kind': 'past_event_user'},
                                        [], false, true, "{{ gettext("CdEDB-ID, Name or E-Mail") }}"
                                    );
                                </script>
                            {% endcall %}
                        </div>
                        <div class="col-sm-2">
                            {{ util.input_select(name="orga_status", aclass="form-control select-action input-sm",
                                                    entries=enums['PastOrgaKind']|enum_entries(processing=gettext)) }}
                        </div>
                        <div class="col-sm-2">
                            {{ util.input_select(name="music_status", aclass="form-control select-action input-sm",
                                                    entries=enums['PastMusicKind']|enum_entries(processing=gettext)) }}
                        </div>
                        <div class="col-sm-2">
                            {{ util.input_submit(label=gettext("Add"), aclass="btn btn-primary btn-sm") }}
                        </div>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}
    {% if participants %}
        <ul id="list-participants" class="flex-width">
            {% for participant in participants.values() %} {# This dict is already sorted. #}
                <li class="hide-hover-container clearfix-after">
                    {{ generic.print_persona(participant.persona) }}
                    {% if course_assignment[participant.persona_id] %}
                        (
                        {%- for assignment in course_assignment[participant.persona_id] -%}{# already sorted #}
                            {{ courses[assignment.pcourse_id]['nr'] }}.
                            {% if assignment.instructor_status -%}
                                <strong title="{{ gettext(assignment.instructor_status|string) }}">
                            {%- endif -%}
                            {{ util.href(cdedblink('cde/show_past_course', {'pcourse_id' : assignment.pcourse_id}), courses[assignment.pcourse_id]['title']) }}
                            {%- if assignment.instructor_status -%}
                                <span class="sr-only"> ({{ gettext(assignment.instructor_status|string) }})</span></strong>
                            {%- endif -%}
                            {%- if not loop.last %}, {% endif -%}
                        {% endfor -%}
                        )
                    {% endif %}
                    {% if participant.orga_status %}
                        ({{ gettext(participant.orga_status|string) }})
                    {% endif %}
                    {% if participant.music_status %}
                        ({{ gettext(participant.music_status|string) }})
                    {% endif %}

                    {% if "past_event" in user.admin_views %}
                        <form action="{{ cdedblink('cde/remove_participant') }}" method="POST"
                              id="removeparticipantform{{ participant.persona_id }}" style="display: inline;"
                              class="delete-participant-form hide-hover display-inline">
                            {{ util.anti_csrf_token('cde/remove_participant') }}
                            {{ util.input_hidden(name="persona_id", value=participant.persona_id) }}
                            {{ util.ack_delete(gettext("The Participant will be removed from the Event.")) }}
                            {{ util.input_submit(title=gettext("Remove"), icon="minus", aclass="btn btn-xs btn-danger list-button-float", label="") }}
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
            {% if participants|length != total_participant_number %}
                <li id="count-extra-participants">
                    {% trans count=total_participant_number-participants|length %}
                        and_one_more
                    {%- pluralize count -%}
                        and_count_more
                    {% endtrans %} …
                </li>
            {% endif %}
        </ul>
    {% elif total_participant_number %}
        <p id="count-extra-participants">
            <i>
                {% trans count=total_participant_number %}
                    {{ count }} Participant
                {%- pluralize count -%}
                    {{ count }} Participants
                {% endtrans %}
            </i>
        </p>
    {% else %}
        <p>
            <i>{% trans %}This Event had no Participants.{% endtrans %}</i>
        </p>
    {% endif %}
    {% if "past_event" in user.admin_views %}
        {% call util.bootstrap_panel(title=gettext("Actions"), icon="exclamation-triangle", aclass="panel-danger mosp") %}
            <div class="row">
                <div class="col-sm-4">
                    <div class="p">
                        <form action="{{ cdedblink('cde/delete_past_event') }}" method="POST"
                                id="deletepasteventform" style="display: inline;">
                            {{ util.anti_csrf_token('cde/delete_past_event') }}
                            {{ util.input_submit(label=gettext("Delete Event"), icon="trash-alt", aclass="btn btn-danger") }}
                            {{ util.ack_delete(gettext("The event will be permanently deleted.")) }}
                        </form>
                    </div>
                </div>
                <div class="col-sm-8">
                    <p class="text-muted">
                        {% trans %}Deletes the event, including description, courses and participant information.{% endtrans %}
                    </p>
                </div>
            </div>
        {% endcall %}
    {% endif %}
{% endblock %}
