{% set sidenav_active='cde_past_events' %}
{% extends "web/cde/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}
{% import "web/cde/past_event/generic.tmpl" as generic with context %}

{% if "past_event" in user.admin_views %}
    {% set jshint='weak' %}
    {% block scripts %}
        {{ util.cdedb_script('cdedb_searchpersona.js') }}
        {{ util.cdedb_script('cdedb_helper.js') }}
    {% endblock %}
{% endif %}

{% block title %}{{ ambience['pcourse']['title'] }} ({{ ambience['pevent']['title'] }}){% endblock %}
{% block heading %}
    {{ util.context_heading(ambience['pcourse']['nr'] + ". " + ambience['pcourse']['title'],
                            ambience['pevent']['title'], 'calendar-alt', gettext("Past Event")) }}
{% endblock %}
{% block breadcrumb %}
{{ super() }}
    {{ util.breadcrumb_link(cdedblink("cde/list_past_events"), gettext("Past Events")) }}
    {{ util.breadcrumb_link(cdedblink("cde/list_past_events", {"institution": ambience['pevent']['institution']}),
                            gettext(ambience['pevent']['institution'].shortname)) }}
    {{ util.breadcrumb_link(cdedblink("cde/show_past_event", {"pevent_id": ambience['pevent']['id']}),
            ambience['pevent']['title'], icon="calendar-alt") }}
    {{ util.breadcrumb_link(cdedblink("cde/show_past_course", {'pcourse_id' : ambience['pcourse']['id']}),
            ambience['pcourse']['title'], icon="book", active=True) }}
{% endblock %}

{% block content %}
    {% if "past_event" in user.admin_views %}
        <div class="p">
            {{ util.href(cdedblink('cde/change_past_course_form'), gettext("Edit"), icon="pen",
                    aclass="btn btn-warning btn-sm") }}
        </div>
    {% endif %}

    <div id="description">{{ ambience['pcourse']['description']|md }}</div>

    {% call util.h(n_("Participants"), level=2) %}
        [{{ total_participant_number }}]
    {% endcall %}
    {% if "past_event" in user.admin_views %}
        {% call util.bootstrap_panel(title=gettext("Add Participant to this Course"),
                aclass="panel-success panel-condensed", icon='plus') %}
                <form action="{{ cdedblink('cde/set_course_assignments') }}" method="POST" id="addparticipantform">
                    {{ util.anti_csrf_token('cde/set_course_assignments') }}
                    {{ util.input_hidden(name="pcourse_id", value=values['pcourse_id']) }}
                    <div class="row">
                        <div class="col-sm-8 {% if 'persona_ids' in errors %}has-error{% endif %}">
                            {% call util.output_errors('persona_ids') %}
                                {{ util.input_text(type="search", name="persona_ids", placeholder="DB-XXXX-X,DB-XXXX-X,…",
                                                   anid='input-add-participant', aclass='form-control input-sm',
                                                   arialabel=gettext("ID of the new Participant")) }}
                                <script nonce="{{ csp_nonce }}">
                                    $('#input-add-participant').cdedbSearchPerson(
                                        '{{ cdedblink('core/select_persona') }}', {'kind' : 'past_event_user'},
                                        [], false, true, "{{ gettext("CdEDB-ID, Name or E-Mail") }}"
                                    );
                                </script>
                            {% endcall %}
                        </div>
                        <div class="col-sm-2">
                                {{ util.input_select(name="instructor_status", aclass="form-control select-action input-sm",
                                                     entries=enums['PastInstructorKind']|enum_entries(processing=gettext)) }}
                        </div>
                        <div class="col-sm-2">
                            {{ util.input_submit(label=gettext("Add"), aclass="btn btn-primary btn-sm") }}
                        </div>
                    </div>
                </form>
        {% endcall %}
    {% endif %}
    {% if participants %}
        <ul id="list-participants" class="flex-width">
            {% for participant in participants.values() %} {# This dict is already sorted. #}
                <li class="hide-hover-container clearfix-after">
                    {% if participant.instructor_status %}<strong>{% endif %}
                    {{ generic.print_persona(personas[participant.persona_id]) }}
                    {% if participant.instructor_status %}</strong>{% endif %}
                    {% if participant.instructor_status %}
                        ({{ gettext(participant.instructor_status|string) }})
                    {% endif %}
                    {% if "past_event" in user.admin_views %}
                        <form action="{{ cdedblink('cde/remove_course_assignment') }}" method="POST"
                              id="removeparticipantform{{ participant.persona_id }}" style="display: inline;"
                              class="delete-participant-form hide-hover display-inline">
                            {{ util.anti_csrf_token('cde/remove_course_assignment') }}
                            {{ util.input_hidden(name="persona_id", value=participant.persona_id) }}
                            {{ util.input_hidden(name="pcourse_id", value=values['pcourse_id']) }}
                            {{ util.ack_delete(gettext("The Participant will be removed from this Course.")) }}
                            {{ util.input_submit(title=gettext("Remove"), icon="minus",
                                    aclass="btn btn-xs btn-danger list-button-float", label="") }}
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
            {% if participants|length != total_participant_number %}
                <li id="count-extra-participants">
                    {% trans count=total_participant_number - participants|length %}
                        and_one_more
                    {%- pluralize count -%}
                        and_count_more
                    {% endtrans %} …
                </li>
            {% endif %}
        </ul>
    {% elif total_participant_number %}
        <p>
            <i id="count-extra-participants">
                {% trans count=total_participant_number %}
                    {{ count }} Participant
                {%- pluralize count -%}
                    {{ count }} Participants
                {% endtrans %}
            </i>
        </p>
    {% else %}
        <p>
            <i>{% trans %}This Course had no Participants.{% endtrans %}</i>
        </p>
    {% endif %}


    {% if "past_event" in user.admin_views %}
        {% call util.bootstrap_panel(title=gettext("Actions"), icon="exclamation-triangle", aclass="panel-danger mosp") %}
            <div class="row">
                <div class="col-sm-4">
                    <div class="p">
                        <form action="{{ cdedblink('cde/delete_past_course') }}" method="POST"
                                id="deletecourseform" style="display: inline;">
                            {{ util.anti_csrf_token('cde/delete_past_course') }}
                            {{ util.input_submit(label=gettext("Delete Course"), icon="trash-alt", aclass="btn btn-danger") }}
                            {{ util.ack_delete(gettext("The Course will be permanently deleted.")) }}
                        </form>
                    </div>
                </div>
                <div class="col-sm-8">
                    <p class="text-muted">
                        {% trans %}Deletes the Course, including Description and Participant information{% endtrans %}
                    </p>
                </div>
            </div>
        {% endcall %}
    {% endif %}

{% endblock %}
