{% macro print_persona(persona) %}
    {% if user.admin_views.has(AdminViews.past_event) or persona['id'] == user.persona_id %}
        {{ util.persona_anchor(persona, include_nickname=true) -}}
    {% elif "searchable" in user.roles and persona['is_member'] and persona['is_searchable'] %}
        {{ util.persona_anchor(persona, include_nickname=true, quote_me=true) -}}
    {% else %}
        {{ persona|persona_name(include_nickname=true) -}}
    {% endif -%}
{% endmacro %}
