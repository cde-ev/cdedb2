{% set sidenav_active='cde_past_events' %}
{% extends "web/cde/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}
{% block title %}{% trans %}Past Events_[[long form]]{% endtrans %}{% endblock %}
{% block breadcrumb %}
    {{ super() }}
    {{ util.breadcrumb_link(cdedblink("cde/list_past_events"), gettext("Past Events"), active=not institution) }}
    {% if institution %}
        {{ util.breadcrumb_link(cdedblink("cde/list_past_events", {'institution': values['institution']}),
                                gettext(institution.shortname), active=True) }}
    {% endif %}
{% endblock %}
{% block content %}
    {% if "past_event" in user.admin_views %}
        <div class="p">
            {{ util.href(cdedblink("cde/create_past_event_form"), gettext("Create Past Event"),
                    aclass="btn btn-success btn-sm", icon="plus") }}
        </div>
    {% endif %}

    <nav>
        <ul class="nav nav-tabs mosp" id="navigation">
            <li role="presentation" {% if 'institution' not in values or not values['institution'] %}class="active" aria-current="page" {% endif %}>
                {{ util.href(cdedblink('cde/list_past_events', {'institution': None}), gettext("Overview")) }}
            </li>
            {% for i in used_institutions|sort %}
                <li role="presentation" {% if i|string == values['institution'] %}class="active" aria-current="page" {% endif %}>
                    {{ util.href(cdedblink('cde/list_past_events', {'institution': i}), i.shortname) }}
                </li>
            {% endfor %}
        </ul>
    </nav>

    {% for year, past_events in years %}
        {{ util.h(year, level=4, underline=True, translate=False) }}
        <ul id="events-{{ year }}">
            {% for pevent in past_events %}
                <li>
                    {{ util.href(cdedblink("cde/show_past_event", {"pevent_id": pevent.id}), pevent.title) }}
                    {% if "past_event" in user.admin_views %}[{{ pevent.shortname }}]{% endif %}
                    {% if not values.get('institution') %}({{ pevent.institution.shortname }}){% endif %}
                    {% if "past_event" in user.admin_views %}
                        <small class="text-muted nowrap">
                            {% trans count=stats[pevent.id]['courses'] %}
                                {{ count }} Course
                            {%- pluralize count -%}
                                {{ count }} Courses
                            {% endtrans %},
                            {% trans count=stats[pevent.id]['participants'] %}
                                {{ count }} Participant
                            {%- pluralize count -%}
                                {{ count }} Participants
                            {% endtrans %}
                        </small>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endfor %}
{% endblock %}
