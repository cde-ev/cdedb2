{% set sidenav_active='cde_past_events_log' %}
{% set jshint = "weak" %}
{% extends "web/cde/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}
{% import "web/logging.tmpl" as logging with context %}
{% block scripts %}
    {{ util.cdedb_script('cdedb_helper.js') }}
    {{ util.cdedb_script('cdedb_searchpersona.js') }}
{% endblock %}
{% block title %}
    {% trans %}Past Events Log{% endtrans %}
    {{ logging.counter(total, values['offset'] or '', length) }}
{% endblock %}
{% block breadcrumb %}
    {{ super() }}
    {{ util.breadcrumb_link(cdedblink("cde/view_past_log"), gettext("Past Events Log"), active=True) }}
{% endblock %}
{% block content %}
    {% call logging.table(log, ['Event', 'Course']) %}
        {% for entry in log %}
            {% set pevent_link = None %}
            {% if entry['pevent_id'] %}
                {% set pevent_link = util.href(cdedblink("cde/show_past_event", {"pevent_id": entry['pevent_id']}),
                                               pevents[entry['pevent_id']]['title']) %}
            {% endif %}
            {% set pcourse_link = None %}
            {% if entry['pcourse_id'] %}
                {% set pcourse_link = util.href(cdedblink("cde/show_past_course", {"pevent_id": entry['pevent_id'], "pcourse_id": entry['pcourse_id']}),
                                                pcourses[entry['pcourse_id']]['title']) %}
            {% endif %}
            {{ logging.row(entry, enums['PastEventLogCodes'], loop.index, [pevent_link, pcourse_link]) }}
        {% endfor %}
    {% endcall %}

    {{ logging.navigation('cde/view_past_log', total, length, loglinks) }}
    {{ logging.filter('cde/view_past_log', enums['PastEventLogCodes'], 'past_event_user', 'pevent_id') }}
{% endblock %}
