{% set sidenav_active='ml_index' %}
{% extends "web/ml/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}

{% block title %}
    {% trans %}Mailinglists{% endtrans %}
{% endblock %}
{% block breadcrumb %}
{{ util.breadcrumb_link(cdedblink("ml/index"), gettext("Mailinglists"), active=True) }}
{% endblock %}

{% macro format_entry(mailinglist) %}
    <li class="hide-hover-container clearfix-after" id="mailinglist{{ mailinglist.id }}">
        {{ util.state_checkbox(subscriptions.get(mailinglist.id)) }}
        {{ util.href(cdedblink("ml/show_mailinglist", {'mailinglist_id': mailinglist.id}), mailinglist.title) }}
        {% if user.persona_id in mailinglist.moderators %}
            {{ util.href(cdedblink('ml/management',{'mailinglist_id' : mailinglist.id}), gettext("Manage"), icon='list',
                    aclass='btn btn-xs btn-info list-button-float hide-hover') }}
        {% endif %}
    </li>
{% endmacro %}

{% block content %}
    {% if user.admin_views.intersection(ALL_MGMT_ADMIN_VIEWS) %}
        {{ generic_ml.index_buttons() }}
    {% endif %}
    <p>
        {% trans general_mailinglists=util.href("https://www.cde-ev.de/vereinsleben/kommunikation/", gettext("general mailinglists")) %}
            Here you can find the CdE’s mailinglists, notably also those linked to events and assemblies.
            Further information about the {{ general_mailinglists }} are provided on the CdE website.
        {% endtrans %}
    </p>
    {% for group, mailinglists in grouped.items() %}
        {{ util.h(group|string) }}
        <div class="row">
            {% for list_slice in mailinglists|slice(2 if mailinglists|length > 5 else 1) %}
            <ul class="styleless col-md-6 {% if not loop.last %}nosp{% endif %}">
                {% for ml in list_slice %}
                    {{ format_entry(ml) }}
                {% endfor %}
            </ul>
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}
