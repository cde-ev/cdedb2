{% set mainnav_active='event' %}
{% if 'event' in ambience %}
    {% if is_privileged_for('quick_show_registration') %}
        {% if not jshint %}
            {% set jshint='weak' %}
        {% endif %}
    {% endif %}
{% elif "event_list" in user.admin_views %}
    {% if not jshint %}
        {% set jshint='weak' %}
    {% endif %}
{% endif %}

{% extends "web/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}

{% macro registration_quicksearch(mobile=false) %}
    <div class="list-group tear-down {% if mobile %}hidden-md hidden-lg{% else %}hidden-xs hidden-sm{% endif %}">
        <form action="{{ cdedblink('event/quick_show_registration') }}" method="GET"
              id="quickregistrationform{% if mobile %}-mobile{% endif %}">
            <div class="sr-only">{% trans %}Search for registration by ID or name{% endtrans %}</div>
            <div class="input-group">
                <input type="search" name="phrase" class="form-control"
                       placeholder="{% trans %}Registration Quick-Access{% endtrans %}"
                       aria-label="{% trans %}Registration Quick-Access{% endtrans %}"/>
                <span class="input-group-btn">
                    {{ util.input_submit("", icon='search', title=gettext("Search")) }}
                </span>
            </div>
        </form>
        {% if not jshint %}
            {{ util.raise_for_test("jshint not set for quick registration search.") }}
        {% endif %}
        <script nonce="{{ csp_nonce }}">
            form = $("#quickregistrationform{% if mobile %}-mobile{% endif %}");
            igroup = form.find('.input-group');
            igroup.children('.input-group-btn').remove();
            igroup.replaceWith(igroup.contents());
            form
                .find("input")
                .cdedbSearchRegistration(
                    '{{ (cdedblink('event/select_registration')|e) + ('?kind=orga_registration&aux='|s) + (values['event_id']|e) + ('&phrase=%s'|s) }}',
                    [], true, false, "{{ gettext("Registration Quick-Access") }}",
                )
                .on("change", function() {
                    if ($(this).val()) {
                        $(this).closest("form").submit();
                    }
                });
        </script>
    </div>
{% endmacro %}

{# Render an event quick search form.

* mobile: If True, show this form only if the screen width is sm or xs.
          If False, show this form only if the screen size is lg or md.
          If None, show the form always, but hide it via js.

* hidden: If True, hide the form initially but show it when the lg or md version of the sidebar heading is clicked.

It is assumed that this is called:
- single event page: once with (mobile=false, hidden=true) and once with (mobile=None, hidden=false).
- other event realm page: Once with (mobile=false, hidden=false) and once with (mobile=true, hidden=false).

This will result in:
- single event page:
  - small screens:
    - the form will be shown at the bottom of the sidenav (which is actually a top nav), regardless of js or not.
  - wide screens:
    - Without js, the form will be shown at the bottom of the sidenav.
    - With js, the form will not be shown at all, but the event title in the sidenav heading becomes clickable and
        is replaced with the form on click.
- other event realm page:
  - small screens:
    - the form will be shown at the bottom of the sidenav.
  - wide screens:
    - the form will be shown after the first block of the sidenav.

#}
{% macro event_quicksearch(mobile=false, hidden=false) %}
    <div class="list-group tear-down
            {% if mobile %}hidden-md hidden-lg{% elif mobile is sameas false %}hidden-xs hidden-sm{% endif %}
            {% if hidden %}softhide{% endif %}
    ">
        {% set form_id = "quickeventform" + ("-mobile" if mobile is not sameas false else "") %}
        <form action="{{ cdedblink('event/redirect_event') }}" method="GET" id="{{ form_id }}">
            <div class="sr-only">{% trans %}Quickly navigate to an event by name{% endtrans %}</div>
            <div class="input-group">
                {{ util.input_select(name="event_id", entries=all_events|entries('id', 'title')|reverse,
                                     nulloption=gettext("Event Quick-Access"), force_noselect=True) }}
                <span class="input-group-btn">
                    {{ util.input_submit("", icon='chevron-right', title=gettext("Go!")) }}
                </span>
            </div>
            {{ util.input_hidden("endpoint", original_endpoint) }}
            {{ util.input_hidden("args", value=requestargs) }}
        </form>
        <script nonce="{{ csp_nonce }}">
            form = $("#{{ form_id }}");
            // Adjust input group styling.
            igroup = form.find(".input-group");
            igroup.children(".input-group-btn").remove();
            igroup.replaceWith(igroup.contents());
            // Add selectize.
            form
                .find("select")
                .cdedbSearchEvent(
                    {{ event_options|tojson }},
                )
                .on("change", function() {
                    if ($(this).val()) {
                        $(this).closest("form").submit();
                    }
                });
            {% if hidden %}
                // Adjust sidebar heading styling.
                {% set heading_selector = ".heading-sidebar .hidden-xs.hidden-sm" %}
                $("{{ heading_selector }}")
                    .addClass("selectize-control")
                    .addClass("single")
                    .wrapInner("<span class='selectize-input'></span>");
                // Replace softhide class with js hide.
                form.parent().removeClass("softhide").hide();
                // Show the form and hide the heading when the heading is clicked.
                $("{{ heading_selector }}")
                    .on("click", function() {
                        $("#{{ form_id }}")
                            .parent()
                            .show()
                            .find("input")
                            .focus();
                        $(this).hide();
                    });
                // Hide the form and show the heading when the form is blurred.
                form
                    .find("input")
                    .on("blur", function () {
                        $("{{ heading_selector }}").show();
                        $(this).closest("form").parent().hide();
                    });
            {% endif %}
            {% if mobile is not sameas false %}
                // Hide the mobile form if the hidden form is available.
                form.parent().addClass("hidden-lg").addClass("hidden-md");
            {% endif %}
        </script>
    </div>
{% endmacro %}


{% macro one_event_links(event) %}

    {% if 'event_list' in user.admin_views %}
        {# Only becomes visible by clicking the heading and only on big screens. #}
        {{ event_quicksearch(hidden=true) }}
    {% endif %}

    <div class="list-group tear-down">
        {% if event.is_visible_for(user, is_registered, privileged=False) or orga_view or 'event_mgmt' in user.admin_views %}
        {{ util.href(cdedblink("event/show_event", {"event_id": event['id']}), gettext("Overview"),
                     aclass="list-group-item", icon="caret-right", active=(sidenav_active == 'event_show')) }}
        {% endif %}
        {% if event['tracks'] and (event['is_course_list_visible'] or orga_view) %}
            {{ util.href(cdedblink("event/course_list", {"event_id": event['id']}), gettext("Courselist"),
                         aclass="list-group-item", icon="book", active=(sidenav_active == 'event_course_list')) }}
        {% endif %}
        {% if is_registered %}
            {{ util.href(cdedblink("event/registration_status", {"event_id": event['id']}), gettext("My Registration"),
                    aclass="list-group-item", icon="sign-in-alt", active=(sidenav_active == 'event_register')) }}
            {% if event['use_additional_questionnaire'] %}
                {{ util.href(cdedblink("event/additional_questionnaire_form", {"event_id": event['id']}), gettext("Questionnaire"),
                        aclass="list-group-item", icon="edit", active=(sidenav_active == 'event_quest')) }}
            {% endif %}
            {% if event.is_course_assignment_visible and is_instructor %}
                {{ util.href(cdedblink("event/show_instructed_courses"), gettext("My Instructed Courses"),
                             aclass="list-group-item", icon="book", active=(sidenav_active == "event_instructed")) }}
            {% endif %}
        {% elif event['is_open'] and "event" in user.roles and not event['is_archived'] %}
            {{ util.href(cdedblink("event/register_form", {"event_id": event['id']}), gettext("Register"),
                    readonly=is_locked, aclass="list-group-item", icon="sign-in-alt",
                    active=(sidenav_active == 'event_register')) }}
        {% elif orga_view %}
            {{ util.href(cdedblink("event/register_form", {"event_id": event.id, "preview": True}), gettext("Registration Preview"),
                    aclass="list-group-item", icon="sign-in-alt", active=(sidenav_active == 'event_register_preview')) }}
        {% endif %}
        {% if (is_participant or orga_view) and event['participant_info'] %}
            {{ util.href(cdedblink("event/participant_info", {"event_id": event['id']}),
                         gettext("Participant info"), aclass='list-group-item', icon='info',
                         active=(sidenav_active == 'participant_info')) }}
        {% endif %}
        {% if (
            (
                event['is_participant_list_visible']
                and (
                    is_participant
                    or orga_view and is_privileged(enums['EventPrivileges'].participant_list)
                )
            ) or (
                orga_view
                and (
                    is_privileged(enums['EventPrivileges'].registrations_read)
                    or is_privileged(enums['EventPrivileges'].checkin)
                )
            )
        ) %}
            {{ util.href(cdedblink("event/participant_list", {"event_id": event['id']}), gettext("Participant list"),
                         aclass="list-group-item", icon="users", active=(sidenav_active == 'event_participant_list')) }}
        {% endif %}
    </div>

    {% if is_privileged_for('quick_show_registration') %}
        {{ registration_quicksearch() }}
    {% endif %}

    {% if is_privileged() or 'event_orga' in user.admin_views %}
        <div class="list-group tear-down">
            {% if is_privileged_for("registration_query") %}
                {{ util.href(cdedblink("event/registration_query", {"event_id": event['id']}), gettext("Registrations"),
                        aclass="list-group-item", icon="list", active=(sidenav_active == 'event_registration')) }}
            {% endif %}
            {% if is_privileged_for("stats") %}
                {{ util.href(cdedblink("event/stats", {"event_id": event['id']}), gettext("Statistics"),
                        aclass="list-group-item", icon="chart-bar", active=(sidenav_active == 'event_stats')) }}
            {% endif %}
            {% if event['tracks'] %}
                {% if is_privileged_for("course_stats") %}
                    {{ util.href(cdedblink("event/course_stats", {"event_id": event['id']}), gettext("Courses"),
                                 aclass="list-group-item", icon="book", active=(sidenav_active == 'event_course_stats')) }}
                {% endif %}
            {% endif %}
            {% if is_privileged_for("lodgements") %}
                {{ util.href(cdedblink("event/lodgements", {"event_id": event['id']}), gettext("Lodgements"),
                        aclass="list-group-item", icon="home", active=(sidenav_active == 'event_lodgements')) }}
            {% endif %}
            {% if is_privileged_for("fee_summary") %}
                {{ util.href(cdedblink('event/fee_summary'), gettext("Fees"),
                             icon='coins', aclass='list-group-item', active=(sidenav_active == 'event_fees')) }}
            {% endif %}
            {% if is_privileged_for("constraint_violations") %}
                {{ util.href(cdedblink("event/constraint_violations", {"event_id": event['id']}),
                             gettext("Inconsistencies"), aclass="list-group-item",
                             active=(sidenav_active == 'event_constraint_violations'), icon='exclamation-circle') }}
            {% endif %}
            {% if is_privileged_for("downloads") %}
                {{ util.href(cdedblink("event/downloads", {"event_id": event['id']}), gettext("Downloads & Import"), aclass="list-group-item",
                        icon="file-download", active=(sidenav_active == 'event_downloads')) }}
            {% endif %}
        </div>

        <div class="list-group tear-down">
            {% if is_privileged_for("change_event_form") %}
                {{ util.href(cdedblink("event/change_event", {"event_id": event['id']}), gettext("Configuration"),
                             icon='cog', aclass="list-group-item", active=(sidenav_active == 'event_config')) }}
            {% endif %}
            {% if is_privileged_for("field_summary_form") %}
                {{ util.href(cdedblink("event/field_summary", {"event_id": event['id']}), gettext("Configure Custom Fields"),
                             icon='tag', aclass="list-group-item", active=(sidenav_active == 'event_field_summary') ) }}
            {% endif %}
            {% if is_privileged_for("configure_registration_form") %}
                {{ util.href(cdedblink("event/configure_registration", {"event_id": event.id}),
                             gettext("Configure Registration"), aclass="list-group-item",
                             active=(sidenav_active == "event_register_config"), icon="check-square") }}
            {% endif %}
            {% if is_privileged_for("configure_additional_questionnaire_form") %}
                {{ util.href(cdedblink("event/configure_additional_questionnaire_form", {"event_id": event.id}),
                             gettext("Configure Questionnaire"), aclass="list-group-item",
                             active=(sidenav_active == "event_quest_config"), icon="plus-square") }}
            {% endif %}
            {% if is_privileged_for("view_event_log") %}
                {{ util.href(cdedblink("event/view_event_log", {"event_id": event['id']}), gettext("Log"), aclass="list-group-item",
                             icon="far fa-list-alt", active=(sidenav_active == 'event_event_log')) }}
            {% endif %}
        </div>

        {% if is_privileged_for("checkin_form") %}
            <div class="list-group tear-down">
                {{ util.href(cdedblink("event/checkin_form", {"event_id": event['id']}), gettext("Checkin"),
                        aclass="list-group-item", icon="check-double", active=(sidenav_active == 'event_checkin')) }}
            </div>
        {% endif %}

        {% if is_privileged_for('quick_show_registration') %}
            {{ registration_quicksearch(mobile=True) }}
        {% endif %}

        {% if 'event_list' in user.admin_views %}
            {# Visible on all screens, but hidden on big screens via js, since the other form is available instead. #}
            {{ event_quicksearch(mobile=None) }}
        {% endif %}

    {% endif %}
{% endmacro %}

{% block base_scripts %}
    {% if 'event' in ambience %}
        {% if is_privileged_for('quick_show_registration') %}
            {% if not jshint %}
                {% set jshint='weak' %}
            {% endif %}
            {{ util.cdedb_script('cdedb_searchregistration.js') }}
        {% endif %}
    {% endif %}
    {% if "event_list" in user.admin_views %}
        {% if not jshint %}
            {% set jshint='weak' %}
        {% endif %}
        {{ util.cdedb_script('cdedb_search_event.js') }}
    {% endif %}
{% endblock %}

{% block breadcrumb %}
    {{ util.breadcrumb_link(cdedblink("event/index"), gettext("Events")) }}
{% endblock %}

{% block static_notifications %}
    {% if 'event' in ambience %}
        {% if ambience['event'].is_archived or ambience['event'].is_cancelled or access_is_limited %}
            {% call util.notification('info') %}
                {% if ambience['event'].is_archived and ambience['event'].is_cancelled %}
                    {% trans %}This event was cancelled and has been archived.{% endtrans %}
                {% elif ambience['event'].is_archived %}
                    {% trans %}This event has been archived.{% endtrans %}
                {% elif ambience['event'].is_cancelled %}
                    {% trans %}This event has been cancelled.{% endtrans %}
                {% endif %}
                {% if access_is_limited %}
                    {% trans mailto=util.href(util.mailto('cdedb@lists.cde-ev.de'), 'cdedb@lists.cde-ev.de') %}
                        Note that access to this event has been limited due to its advanced age.
                        Contact {{ mailto }} if you have some need of information stored here.
                    {% endtrans %}
                {% endif %}
            {% endcall %}
        {% elif ambience['event'].registration_start and not ambience['event'].is_registration_approved %}
            {% if is_privileged_for("event/change_event") %}
                {% call util.notification('warning') %}
                    {% trans %}
                        A registration start has been configured, but the registration has not yet been approved.
                        People will not be able to register at the configured time.
                    {% endtrans %}
                    {% if ambience['event'].caretakers %}
                        {% trans %}
                            You should discuss this with your assigned caretakers.
                        {% endtrans %}
                    {% else %}
                        {% trans akademieteam=util.href(util.mailto(EVENT_ADMIN_ADDRESS, cc=ambience['event'].orga_address|s), "Akademieteam") %}
                            You should discuss this with the {{ akademieteam }}.
                        {% endtrans %}
                    {% endif %}
                {% endcall %}
            {% endif %}
        {% endif %}
    {% endif %}
{% endblock %}

{% block navigation %}
    {% if 'event' in ambience %}
        <p>
            {{ util.href(cdedblink("event/index"), gettext("Event-Overview"), icon="arrow-alt-circle-up") }}
        </p>

        {% set heading = util.make_icon('chalkboard-teacher', arialabel=gettext("Event")) ~ " " ~ ambience['event']['title'] %}
        <h3 class="heading-sidebar">
            {% if "event_list" in user.admin_views %}
                {# This looks strange but is useful to add a "click" event only to the heading for big screens. #}
                <span class="hidden-xs hidden-sm">
                    {{ heading }}
                </span>
                <span class="hidden-lg hidden-md">
                    {{ heading }}
                </span>
            {% else %}
                {{ heading }}
            {% endif %}
        </h3>
        {{ one_event_links(ambience['event']) }}
    {% else %}
        <h3 class="heading-sidebar">{% trans %}Events{% endtrans %}</h3>
        <div class="list-group tear-down">
            {{ util.href(cdedblink("event/index"), gettext("Overview"), aclass="list-group-item",
                             icon="caret-right", active=(sidenav_active == 'event_index')) }}
            {% if 'event_list' in user.admin_views %}
                {{ util.href(cdedblink("event/list_events"), gettext("All Events"),
                             aclass="list-group-item", icon="cog", active=(sidenav_active == 'event_list')) }}
                {{ util.href(cdedblink("event/constraint_violations_summary"), gettext("Inconsistencies"),
                             aclass="list-group-item", icon="exclamation-circle", active=(sidenav_active == 'violations_summary')) }}
            {% endif %}
            {% if "event" in user.roles %}
                {{ util.href(cdedblink("event/list_event_helpers"), gettext("Event Helpers"), aclass="list-group-item",
                             icon="handshake-angle", active=(sidenav_active == 'event_helpers')) }}
            {% endif %}
        </div>
        {% if 'event_list' in user.admin_views %}
            {{ event_quicksearch() }}
        {% endif %}
        {% if user.admin_views.intersection(('event_mgmt', 'event_user', 'auditor')) %}
            <div class="list-group tear-down">
                {% if 'event_user' in user.admin_views %}
                        {{ util.href(cdedblink("event/user_search"), gettext("Manage Users"),
                                     aclass="list-group-item", icon="users", active=(sidenav_active == 'event_users')) }}
                {% endif %}
                {% if user.admin_views.intersection(('event_mgmt', 'auditor')) %}
                        {{ util.href(cdedblink("event/view_log"), gettext("Log"), aclass="list-group-item", icon="far fa-list-alt",
                                     active=(sidenav_active == 'event_log')) }}
                {% endif %}
            </div>
        {% endif %}
        {% if 'event_list' in user.admin_views %}
            {{ event_quicksearch(mobile=True) }}
        {% endif %}
    {% endif %}
    <hr class="strong visible-xs visible-sm" />
{% endblock %}

{% block adminviews %}
    {% if 'event' in ambience %}
        {% if ambience['event'].id in (user.orga.union(user.caretaker)) %}
            {{ util.admin_views_toggle((
                    (gettext("Event Administration"), ["event_mgmt", "event_list"], ["event_mgmt"]),
                )) }}
        {% else %}
            {{ util.admin_views_toggle((
                    (gettext("Event Administration"), ["event_mgmt", "event_list"], ["event_mgmt"]),
                    (gettext("Orga Controls"), ["event_orga"], None),
                )) }}
        {% endif %}
    {% else %}
        {{ util.admin_views_toggle((
                (gettext("User Administration"), ["core_user", "cde_user", "event_user", "ml_user", "assembly_user"], ["event_user"]),
                (gettext("Event Administration"), ["event_mgmt", "event_list"], None),
                (gettext("Auditor"), ["auditor"], None),
            )) }}
    {% endif %}
{% endblock %}
