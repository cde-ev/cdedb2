{% import "web/util.tmpl" as util with context %}
{# A macro to generate the form select fields for all course choices of a given track.

    cco                 The course choice object.
    all_courses         A dict containing all courses of the current event.
    course_choices      A dict containing a mapping from track to a list of ids of all choosable courses.
                        Choosable courses can differ depending on event state and orga privileges.
    all_course_choices  A dict containing a mapping from track to a list of ids of all offered courses.
    show_track_titles   A bool deciding whether to print or omit the title of the track.
#}
{% macro select_course_choice(cco, all_courses, course_choices, all_course_choices, show_track_title) %}
    {% set track = cco.reference_track %}
    <div id="course-choice-container-{{ track['id'] if not cco.is_complex() else "group-{}".format(cco['id'])  }}"
         class="course_choice_container">
        <h4>
            {% trans %}Course Choices{% endtrans %}
            {% if show_track_title %}
                {% trans track=cco['title'] %}
                    for {{ track }}
                {% endtrans %}
            {% endif %}
        </h4>

        {% set course_entries = all_courses|entries('id', 'label', include=course_choices) %}
        {% set all_course_entries = all_courses|entries('id', 'label', include=all_course_choices) %}
        {% if cco.is_complex() %}
            {% set choice_name = "group{}.course_choice".format(cco['id']) + "_{}" %}
            {% set instructor_name = "group{}.course_instructor".format(cco['id']) %}
        {% else %}
            {% set choice_name = "track{}.course_choice".format(track['id']) + "_{}" %}
            {% set instructor_name = "track{}.course_instructor".format(track['id']) %}
        {% endif %}
        {% set num_choices = track['num_choices'] %}
        {% set min_choices = track['min_choices'] %}

        {% for i in range(num_choices) %}
            {{ util.form_input_select(name=choice_name.format(i), nulloption=nbsp,
                                      aclass="choice_group_select" if cco.is_complex() else "",
                                      attributes="data-track_group_id={}".format(cco['id']) if cco.is_complex() else "",
                                      label=gettext("%s. Choice")|format(i + 1), entries=course_entries,
                                      info=(gettext("Optional choice") if i >= min_choices else "")) }}
        {% endfor %}

        {{ util.form_input_select(name=instructor_name, entries=all_course_entries,
                                  nulloption=gettext("– I am not an Instructor –"), label=gettext("Instructed Course"),
                                  info=gettext("If you are instructing a course, please specify which one.")) }}
    </div>
{% endmacro %}

{% macro select_all_course_choices(involved_tracks=None) %}
    {% for cco in choice_objects %}
        {% if cco.is_complex() %}
            {% set course_choices = courses_per_track_group[cco.id] %}
            {% set all_course_choices = all_courses_per_track_group[cco.id] %}
        {% else %}
            {% set course_choices = courses_per_track[cco.id] %}
            {% set all_course_choices = all_courses_per_track[cco.id] %}
        {% endif %}
        {% if involved_tracks is none or involved_tracks.intersection(cco.tracks) %}
            {{ select_course_choice(cco, courses, course_choices, all_course_choices,
                                    show_track_title=choice_objects|length > 1) }}
        {% endif %}
    {% endfor %}
{% endmacro %}

{# Display the value of a custom event field.
   This is the counterpart of (form_)field_input.

    field       A dict containing all information of a custom event field.
    entry       The value of the field of the current entity.
    otherwise   Display this string if the field has no value set.
#}
{% macro display_field(field, entry, otherwise='—') %}
    {% if field['entries'] %}
        {{ field.entries.get(entry, otherwise) }}
    {% else %}
        {% set datatypes = enums['FieldDatatypes'] %}
        {% if field['kind'] == datatypes.bool %}
            {{ util.deko_checkbox(checked=entry) }}
        {% elif field['kind'] == datatypes.date %}
            {{ entry|date(lang=lang, passthrough=True) or otherwise }}
        {% elif field['kind'] == datatypes.datetime %}
            {{ entry|datetime(lang=lang, passthrough=True) or otherwise }}
        {% elif field['kind'] in (datatypes.float, datatypes.non_negative_float) %}
            {{ entry|decimal(lang=lang) or otherwise }}
        {% elif field['kind'] == datatypes.phone %}
            {{ util.tel_link(entry|phone) if entry else otherwise }}
        {% elif field['kind'] == datatypes.iban %}
            {{ entry|iban or otherwise }}
        {% elif field['kind'] == datatypes.str_monospace %}
            <pre class="monospace">
                {{- entry|linebreaks or otherwise -}}
            </pre>
        {% else %}
            {{ entry|linebreaks or otherwise }}
        {% endif %}
    {% endif %}
{% endmacro %}

{# Set the value of a custom event field.
   This is the counterpart of display_field.

    field       A dict containing all information of a custom event field.
    name        The name of the field, defaults to 'fields.field_name'
    bool_label  Special label for the field_input (not the form*!) if the field is of type bool
#}
{% macro field_input(field, name=none, readonly=False, defaultvalue='', anid=none, bool_label=none) %}
    {%- set name = name or "fields." + field['field_name'] %}
    {# Wrapping is necessary to identify the data field for the fee preview. #}
    <div id="field.{{ field['field_name'] }}" data-field_id="{{ field['id'] }}">
    {%- if field['entries'] %}
        {{- util.input_select(name=name, entries=field['entries'].items(), nulloption=nbsp if None not in field.entries else None,
                              readonly=readonly, defaultvalue=defaultvalue, anid=anid, sort=False) }}
    {%- else %}
        {% set datatypes = enums['FieldDatatypes'] %}
        {% set to_input_type = {
            datatypes.bool: 'bool',
            datatypes.str: 'text',
            datatypes.str_multiline: 'textarea',
            datatypes.str_monospace: 'textarea_monospace',
            datatypes.int: 'number',
            datatypes.float: 'number',
            datatypes.date: 'date',
            datatypes.datetime: 'datetime-local',
            datatypes.non_negative_int: 'number',
            datatypes.non_negative_float: 'number',
            datatypes.phone: 'tel',
            datatypes.iban: 'iban',
        } %}
        {% set type = to_input_type.get(field.kind, 'text') %}
        {%- if type == 'bool' %}
            <div class="checkbox{% if readonly %} disabled{% endif %}">
                {{- util.input_checkbox(name=name, readonly=readonly, defaultvalue=defaultvalue,
                                        anid=anid, label=bool_label) -}}
            </div>
        {%- elif type == 'textarea' %}
            {{- util.input_textarea(name=name, readonly=readonly, defaultvalue=defaultvalue,
                                    anid=anid, rows=field.kind.text_rows) }}
        {%- elif type == 'textarea_monospace' %}
            {{- util.input_textarea(name=name, readonly=readonly, defaultvalue=defaultvalue,
                                    anid=anid, rows=field.kind.text_rows, aclass='form-control monospace') }}
        {%- else %}
            {{- util.input_text(name=name, readonly=readonly, defaultvalue=defaultvalue, anid=anid, type=type,
                attributes='placeholder=0.00' if type in (datatypes.float, datatypes.non_negative_float) else '') }}
        {%- endif %}
    {%- endif %}
    </div>
{%- endmacro %}


{# Set the value of a custom event field inside a form.
   This is the counterpart of display_field.

    field       A dict containing all information of a custom event field.
    name        The name of the field, defaults to 'fields.field_name'
    force_label Enforce the presentation of the label in the surrounding form_* even if the field is of type bool
#}
{% macro form_field_input(field, name=none, label=none, info='', displayerrors=True, readonly=False,
                          defaultvalue='', anid=none, force_label=False, outerclass='') %}
    {%- set name = name or "fields." + field.field_name %}
    {%- set form_label = label or field.title %}
    {%- if field.kind == enums['FieldDatatypes'].bool and not force_label and not field.entries %}
        {%- set form_label = none %}
    {%- endif %}
    {%- set anid = anid or "event-input-{}".format(name) %}
    {%- call util.form_input_general(name=name, label=form_label, anid=anid, small=False, info=info,
                                     displayerrors=displayerrors, horizontal=True, aclass=outerclass) %}
        {{- field_input(field, name, readonly, defaultvalue, anid, bool_label=label or field.title) }}
    {%- endcall %}
{%- endmacro %}


{% macro print_field_inputs(association, is_restricted=False) %}
    {% if ambience['event'].grouped_fields[association]|length > 0 %}
        <h3 class="heading-underline">{% trans %}Custom Fields{% endtrans %}</h3>
        {% if is_restricted %}
            <p class="text-info">
                {{ util.make_icon("info-circle") }}{{ nbsp -}}
                {% trans %}
                    Checkin helpers may only access a subset of custom fields.
                {% endtrans %}
            <p>
        {% endif %}
        {% for title, fields in ambience['event'].grouped_fields[association].items() %}
            {% if ambience['event'].grouped_fields[association]|length > 1 %}
                <h4 class="heading-underline">
                    {{ title or gettext("Other Fields") }}
                </h4>
            {% endif %}
            {% for field in fields if field.checkin or not is_restricted %}
                {{ form_field_input(field, info=field.description) }}
            {% else %}
                <p class="text-muted">
                    {% trans %}No custom fields in this group available to you.{% endtrans %}
                </p>
            {% endfor %}
        {% else %}
            <p class="text-muted">
                {% if association == enums['FieldAssociations'].lodgement %}
                    {% trans %}No custom fields for lodgements available.{% endtrans %}
                {% elif association == enums['FieldAssociations'].course %}
                    {% trans %}No custom fields for courses available.{% endtrans %}
                {% else %}
                    {% trans %}No custom fields for registrations available.{% endtrans %}
                {% endif %}
            </p>
        {% endfor %}
    {% endif %}
{% endmacro %}

{% macro print_foto_notice() %}
    {% trans %}
        In the context of this event, photos and recordings will be made to be used for the
        event-documentation and a CdE-internal, password protected media collection. Individual photos and
        recordings can be excluded from this by request.
    {% endtrans %}
{% endmacro %}

{% macro print_questionnaire_entry(row) %}
    <div id="questionnaire_row_{{ row.pos }}">
    {% if row.name == "QuestionnaireFieldRow" %}
        {{ form_field_input(
                row.field, label=row.label, info=row.info|md|replace("<p>", "")|replace("</p>", "") if row.info else "",
                readonly=row.readonly or is_locked, defaultvalue=row.default_value if not (row.readonly or is_locked) else ""
            ) }}
    {% elif row.name == "QuestionnaireTextRow" %}
        {{ row.text|md }}
    {% elif row.name == "QuestionnaireHeadingRow" %}
        {{ util.h(row.title, level=row.kind.title_level, underline=True, translate=False) }}
    {% elif row.name == "FeePreview" %}
        {% call fee_preview_panel() %}
            <p class="text-info fw-bold" id="nonmember-surcharge">
                {% if not persona["is_member"] %}
                    {% trans %}
                        Because you are not a CdE-Member, you might have to pay an additional "External Fee".
                    {% endtrans %}
                    {% if persona["is_cde_realm"] %}
                        {% trans %}
                            If you pay your membership fee before your registration fee, the additional fee will be waived.
                        {% endtrans %}
                    {% endif %}
                {% endif %}
            </p>
        {% endcall %}
    {% elif row.name == "CourseChoices" %}
        {% if choice_objects %}
            {{ util.h("Course Choices", level=3, underline=True) }}
            {{ select_all_course_choices(involved_tracks=involved_tracks) }}
        {% endif %}
    {% elif row.name == "PartSelection" %}
        {% if ambience['event'].parts|length > 1 %}
            {{ util.h("Registration", level=3, underline=True) }}
            {{ util.form_input_checkboxes(
                    name="parts", label=gettext("Event Parts"), entries=part_options, readonly=(registration and not preview),
                    defaultvalue=payment_parts, info=gettext("In order to change the parts you are registered for, contact the orgas.")
                ) }}
        {% elif ambience['event'].parts|length == 1 %}
            {{ util.input_hidden(name="parts", value=(ambience['event'].parts|list)[0]) }}
        {% endif %}
    {% elif row.name == "ListConsent" %}
        {{ util.form_input_checkbox(
                name="reg.list_consent", defaultvalue='True', label=gettext("Participant List Consent"),
                info=gettext(
                    "I agree that my data, including my name, address and my email, may be sent"
                    " to other participants of this event beforehand."
                )
            ) }}
    {% elif row.name == "MixedLodging" %}
        {% if not age_class.may_mix() %}
            {{ util.input_hidden(name="reg.mixed_lodging", value=False) }}
            {{ util.form_input_static(label=gettext("Mixed Lodging"), value=gettext("Mixed Lodging not possible.")) }}
        {% else %}
            {% if age_class.is_minor() %}
                {% set mix_info = gettext("The selection must be compatible with the parental consent form.") %}
            {% else %}
                {% set mix_info = "" %}
            {% endif %}
            {{ util.form_input_select(
                    name="reg.mixed_lodging",
                    entries=(
                        (True, gettext("I agree to mixed lodging.")),
                        (False, gettext("I want to be lodged separated by gender.")),
                    ),
                    label=gettext("Mixed Lodging"), info=mix_info
                ) }}
        {% endif %}
    {% elif row.name == "FotoNotice" %}
        {% call util.form_input_general(label=gettext("Photo consent"), displayerrors=False) %}
            <p class="nosp">
                {{ print_foto_notice() }}
            </p>
        {% endcall %}
    {% elif row.name == "RegistrationNotes" %}
        {%- if ambience["event"].tracks %}
            {%- set noteslabel = gettext("Notes for Orgas and Instructors") %}
        {%- else %}
            {%- set noteslabel = gettext("Notes for Orgas") %}
        {%- endif %}
        {{ util.form_input_textarea(name="reg.notes", label=noteslabel, rows="5") }}
    {% elif row.name == "TableOfContents" %}
        <div class="toc">
            <ul>
                {% for other_row in row.questionnaire.text_rows if other_row.title %}
                    <li>{{ util.href("#" + "_".join(other_row.title.split()), other_row.title) }}</li>
                {% endfor %}
            </ul>
        </div>
    {% elif row.name == "MyData" %}
        {{ util.h("My Data", level=3, underline=True) }}
        <dl class="dl-horizontal">
            <dt title="{% trans %}Full Name{% endtrans %}">{% trans %}Full Name{% endtrans %}</dt>
            <dd>
                {{ persona|persona_name(include_nickname=True, with_titles=True) }}
            </dd>

            <dt title="{% trans %}Birthday{% endtrans %}">{% trans %}Birthday{% endtrans %}</dt>
            <dd>{{ persona['birthday']|date(lang=lang) }}</dd>
            <dt title="{% trans %}Gender{% endtrans %}">{% trans %}Gender{% endtrans %}</dt>
            <dd>{{ gettext(enums['Genders'](persona['gender'])|string) }}</dd>
            <dt title="{% trans %}Pronouns{% endtrans %}">{% trans %}Pronouns{% endtrans %}</dt>
            <dd>{{ persona['pronouns'] }}</dd>
            <dt title="{% trans %}Show pronouns on nametags{% endtrans %}">{% trans %}Pronouns on nametags{% endtrans %}</dt>
            <dd>{{ util.deko_checkbox(persona['pronouns_nametag']) }}</dd>
            <dt title="{% trans %}E-Mail{% endtrans %}">{% trans %}E-Mail{% endtrans %}</dt>
            <dd> {{ persona['username'] }} </dd>
            <dt title="{% trans %}Phone{% endtrans %}">{% trans %}Phone{% endtrans %}</dt>
            <dd>{{ persona['telephone']|phone }}</dd>
            <dt title="{% trans %}Mobile Phone{% endtrans %}">{% trans %}Mobile Phone{% endtrans %}</dt>
            <dd>{{ persona['mobile']|phone }}</dd>
            <dt title="{% trans %}Address{% endtrans %}">{% trans %}Address{% endtrans %}</dt>
            <dd>{{ persona['address'] }}</dd>
            <dt title="{% trans %}Address Supplement{% endtrans %}">{% trans %}Address Supplement{% endtrans %}</dt>
            <dd>{{ persona['address_supplement'] }}</dd>
            <dt title="{% trans %}City{% endtrans %}">{% trans %}City{% endtrans %}</dt>
            <dd>{{ persona['postal_code'] }} {{ persona['location'] }}</dd>
            <dt title="{% trans %}Country{% endtrans %}">{% trans %}Country{% endtrans %}</dt>
            <dd>{{ util.gettext_country(persona['country']) }}</dd>
        </dl>
        <p>
            {% trans link=util.href(cdedblink('core/change_user'), gettext("form to edit your profile")) %}
                This data is taken from your personal profile. To change it, use this {{ link }}.
            {% endtrans %}
            {% trans %}
                Any changes made to your profile data will be carried over automatically and shared with the orgateam.
            {% endtrans %}
        </p>
    {% else %}
        {{ row }}
        {{ util.raise_for_test("Unhandled QuestionnaireRow Role: " + row.name) }}
    {% endif %}
    </div>
{% endmacro %}


{# Macro for a general questionnaire part, that can have each role in the DynamicRow workflow.
   aclass is used to pass classes to the row, such as drow-row, drow-prototype, drow-new
   newrow rows will have 'create' instead of 'delete' checkbox and have 'data-basename' attributes #}
{% macro questionnaire_config_entry(part_id, kind, aclass="", newrow=False) %}
    <div class="panel panel-default {{ aclass }}" data-drow-id="{{ part_id }}">
        <div class="panel-heading">
            <div class="pull-right">
                <span class="drow-hide">
                    {% if newrow %}
                        {{ util.input_checkbox(
                                "create_" ~ part_id, label=gettext("Add"), aclass='drow-indicator',
                                attributes={"data-basename": "create_"}|xmlattr
                            ) }}
                    {% else %}
                        {{ util.input_checkbox(
                                "delete_" ~ part_id, label=gettext("Remove"), aclass='drow-indicator'
                            ) }}
                    {% endif %}
                </span>
                <button title="{{ gettext("Move row up.") }}" aria-label="{{ gettext("Move row up.") }}"
                        type="button" class="btn btn-primary btn-sm drow-move-row-up-button"
                        style="display: none">
                    {{- util.make_icon("caret-up") -}}
                </button>
                <button title="{{ gettext("Move row down.") }}" aria-label="{{ gettext("Move row down.") }}"
                        type="button" class="btn btn-primary btn-sm drow-move-row-down-button"
                        style="display: none">
                    {{- util.make_icon("caret-down") -}}
                </button>
                <button title="{{ gettext("Add new row above.") }}" aria-label="{{ gettext("Add new row above.") }}"
                        type="button" class="btn btn-success btn-sm drow-inline-add-button"
                        style="display: none">
                    {{- util.make_icon("plus") -}}
                </button>
                <span class="drow-buttonspace"></span>
            </div>
            {{ util.input_hidden(
                    "pos_" ~ part_id, defaultvalue=part_id, aclass="input-pos drow-input",
                    attributes={"data-basename": "pos_"}|xmlattr) }}
            {% if newrow %}
                <div style="width: 75%;">
                    {{ util.form_input_select(
                            "role_" ~ part_id, label=gettext("Role"),
                            entries=available_magic_roles|enum_entries(processing=gettext),
                            aclass='input-role drow-input', horizontal=False, small=True,
                            attributes={
                                "data-basename": "role_",
                            }|xmlattr
                        ) }}
                </div>
            {% else %}
                <h3 class="panel-title" style="margin: 5px 0 0">
                    {% set role = values["role_" ~ part_id] %}
                    {% if role is string %}
                        {% set role = enums["QuestionnaireRowRole"][role.split(".", 1)[1]] %}
                    {% endif %}
                    {% if role %}
                        {{ util.make_icon(role.get_class().get_icon()) }}
                    {% endif %}
                    {{ gettext(values["role_" ~ part_id]|string) }}
                </h3>
                {{ util.input_hidden("role_" ~ part_id, aclass="input-role") }}
            {% endif %}
            <div style="clear:both;"></div>
        </div>
        <div class="panel-body" style="padding: 10px 10px 10px 15px;">
            <div class="row">
                <div class="col-md-6">
                    {{ util.form_input_select(
                            "field_id_" ~ part_id, label=gettext("Custom Field"),
                            entries=available_fields|entries(
                                'id', 'field_name', group="sort_group", default_group=gettext("Other Fields")
                            ),
                            nulloption=gettext("— select a field —"),
                            aclass='input-field drow-input', horizontal=False,
                            attributes={
                                "data-basename": "field_id_",
                                "data-show_for_role": get_roles_with_field("field_id")|map("string")|list,
                            }|xmlattr
                        ) }}
                    {{ util.form_input_text(
                            "default_value_" ~ part_id, label=gettext("Default Value"),
                            aclass='input-defaultvalue drow-input', horizontal=False,
                            attributes={
                                "data-basename": "default_value_",
                                "data-show_for_role": get_roles_with_field("default_value")|map("string")|list,
                            }|xmlattr
                        ) }}
                    <div class="checkbox">
                        {{ util.input_checkbox(
                                "readonly_" ~ part_id, label=gettext("read-only"), aclass='input-readonly drow-input',
                                attributes={
                                    "data-basename": "readonly_",
                                    "data-show_for_role": get_roles_with_field("readonly")|map("string")|list,
                                }|xmlattr,
                                readonly=(not values["readonly_" ~ part_id] and (kind and not kind.allow_readonly()))
                            ) }}
                        {{ util.output_errors("readonly_" ~ part_id, wrapper=True) }}
                    </div>
                </div>
                <div class="col-md-6">
                    {{ util.form_input_text(
                            "label_" ~ part_id, label=gettext("Label"),
                            aclass='input-label drow-input', horizontal=false,
                            attributes={
                                "data-basename": "label_",
                                "data-show_for_role": get_roles_with_field("label")|map("string")|list,
                            }|xmlattr
                        ) }}
                    {{ util.form_input_textarea(
                            "info_" ~ part_id, label=gettext("Info"), markdown=True,
                            aclass='input-info drow-input', horizontal=False, rows=5,
                            attributes={
                                "data-basename": "info_",
                                "data-show_for_role": get_roles_with_field("info")|map("string")|list,
                            }|xmlattr
                        ) }}
                </div>
            </div>
            {{ util.form_input_text(
                    "title_" ~ part_id, label=gettext("Title"),
                    aclass='input-title drow-input', horizontal=false,
                    attributes={
                        "data-basename": "title_",
                        "data-show_for_role": get_roles_with_field("title")|map("string")|list,
                    }|xmlattr
                ) }}
            {{ util.form_input_textarea(
                    "text_" ~ part_id, label=gettext("Text"), markdown=True,
                    aclass='input-text drow-input', horizontal=False, rows=5,
                    attributes={
                        "data-basename": "text_",
                        "data-show_for_role": get_roles_with_field("text")|map("string")|list,
                    }|xmlattr
                ) }}
        </div>
    </div>
{% endmacro %}

{% macro constraint_violations_panel(severity, title=gettext("Inconsistencies"), icon='exclamation-circle', anid="constraint-violations", link_title=False) %}
    {% set caller_content = caller() %}
    {% if link_title %}
        {% set title = util.href(cdedblink("event/constraint_violations"), title, icon=icon) %}
        {% set icon = none %}
    {% endif %}
    {% call util.bootstrap_panel(
            title=title, icon=icon, anid=anid, aclass=severity.panel_class()) %}
        {{ caller_content }}
    {% endcall %}
{% endmacro %}

{% macro print_violation(violation, entity_page) %}
    {% set msgs, params = violation.get_translation(entity_page=entity_page) %}
    {% for key, (link_target, link_params, link_anchor) in violation.get_link_params().items() if key in params %}
        {% do params.update({key: util.href(cdedblink(link_target, link_params) + link_anchor, params[key])}) %}
    {% endfor %}
    {% for msg in msgs %}
        {{ gettext(msg)|format(**params)|s }}
    {% endfor %}
{% endmacro %}

{% macro list_violations(class_name, violations, entity_page, min_severity=enums['ViolationSeverity'].INFO, violation_kind=None) %}
    <ul id="{{ class_name }}-list" {% if entity_page %} class="slim" {% endif %}>
        {% for violation in violations %}
            <li class="{{ violation.severity.html_class() }} violations
                    {%- if (violation.severity < min_severity
                            or violation_kind and violation_kind != violation.kind) -%}
                        {{ " softhide " }}
                    {%- endif -%}
                "
                data-max_severity="{{ violation.severity.value }}"  {# For toggling visibility by the filter JS. #}
                data-violation_kind="{{ violation.kind.value }}"  {# For toggling visibility by the filter JS. #}
                data-severity="{{ violation.severity.value }}"  {# For finding the shown violations during the tests. #}
            >
                {{ print_violation(violation, entity_page=entity_page) }}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% macro camping_mat_icon(is_camping_mat, may_camping_mat) %}
    {%- if is_camping_mat and may_camping_mat  %}
        <span title="{{ gettext("Assigned to sleep on a camping mat.") }}">
            {{- util.make_icon('campground') -}}
            {{- util.make_icon('arrow-left') -}}
        </span>
    {%- elif may_camping_mat %}
        {{ util.make_icon('campground', aclass='fag', title=gettext("May sleep on a camping mat.")) }}
    {%- elif is_camping_mat %}
        <span title="{{ gettext("Assigned to, but may not sleep on a camping mat.") }}">
            {{- util.make_icon('campground', aclass='text-warning') -}}
            {{- util.make_icon('exclamation', aclass='text-warning') -}}
        </span>
    {%- endif %}
{%- endmacro %}

{% macro active_fee_registration_query_link(registration_ids, label=None, anid="", query=None, fee_id=None, kind=None) %}
    {%- with query = query or get_query(registration_ids, fee_id, kind) %}
        {{ util.href(cdedblink(query.scope.get_target(redirect=True), query.serialize_to_url()) + '#query-results',
                     registration_ids|length|string + (" " + label if label else ""), icon='list',
                     title=gettext("View Registrations"), anid=anid, readonly=not is_privileged_for(query.scope.get_target())) }}
    {%- endwith -%}
{%- endmacro %}

{% macro _fee_amount_td(amount, fee_id) %}
    <td class="text-right" id="eventfee_amount_{{ fee_id }}">
        {{ _print_fee_amount(amount) }}
    </td>
{% endmacro %}

{% macro _print_fee_amount(amount) -%}
    <strong class="{{ "money-negative" if (amount or 0) < 0 else "money-positive" }}">
        {%- if amount is not none -%}
            {{- amount|money(lang=lang) -}}
        {%- else -%}
            –
        {%- endif -%}
    </strong>
{%- endmacro %}

{% macro _fee_amount_range_td(fee) %}
    <td class="text-right" id="eventfee_amount_{{ fee.id }}">
        <strong>
            {{ _print_fee_amount_range(fee) }}
        </strong>
    </td>
{% endmacro %}

{% macro _print_fee_amount_range(fee) -%}
    {%- if fee.amount_min is none or fee.amount_max is none -%}
        –
    {%- elif fee.amount_min == fee.amount_max -%}
        {{ _print_fee_amount(fee.amount_min) }}
    {%- else -%}
        {{ _print_fee_amount(fee.amount_min) }}
        –
        {{ _print_fee_amount(fee.amount_max) }}
    {%- endif -%}
{%- endmacro %}

{% macro print_fee_type_icon(kind, print_name=False) -%}
    {{- util.make_icon(kind.get_icon(), title=gettext(kind|string)) -}}
    {%- if print_name -%}
        {{- nbsp -}}
        {{- gettext(kind|string) -}}
    {%- endif -%}
    <small class="nowrap text-muted float-right" style="margin-left: 1em;">
        {{- util.make_icon(kind.category.get_icon(), title=gettext("Category_[[EventFee]]") + ": " + gettext(kind.category|string)) -}}
            {{- nbsp -}}
        {{- util.make_icon(kind.budget.get_icon(), title=gettext("Budget_[[EventFee]]") + ": " + gettext(kind.budget|string)) -}}
    </small>
{%- endmacro %}

{#  Print a summary of all relevant fees.
    Has esssentially three different usage modes:

    js_preview = True:
        Used on the `registration_preview` page. Uses js and the `precompute_fee`
        endpoint to display the correct checkboxes and add css classes to active fees.
    js_preview = False and complex_fee is None:
        Used on the global fee summary. Display the fee notes on this page, but don't
        show checkboxes or add classes to active fees (since there is no registration
        to decide whether they are active).
    js_preview = False and complex_fee is not None:
        Used on the registration fee summary. Do not display notes, but mark active
        fees statically without js.
#}
{% macro fee_composition_table(js_preview=False) %}
    <table id="fee-summary" class="table table-hover" {% if js_preview %}style="display: none"{% endif %}>
        <thead>
            <tr>
                <th>{% trans %}Type{% endtrans %}</th>
                <th>{% trans %}Title{% endtrans %}</th>
                <th class="text-right">{% trans %}Amount{% endtrans %}</th>
                {% if not js_preview and complex_fee %}
                    <th></th>
                {% endif %}
                {% if not js_preview and not complex_fee %}
                    <th colspan="2">
                        {% trans %}Registrations{% endtrans %}{{ nbsp }}&amp;
                        {% trans %}Total{% endtrans %}
                    </th>
                {% endif %}
                <th style="width: 100%">{% trans %}Condition{% endtrans %}</th>
                {% if not js_preview %}<th></th>{% endif %}
            </tr>
        </thead>
        <tbody>
        {% for fee in ambience['event'].fees.values()|sort %}
            {% set format = violations.get(fee=fee).event_fee_summary_format if violations else ViolationFormat() -%}
            {% set aclass, atitle = format.html_class, format.get_title(gettext) %}
            <tr id="eventfee_{{ fee.id }}" data-fee_id="{{ fee.id }}" class="eventfee">
                <td class="nowrap">
                    {{- util.make_icon(fee.kind.get_icon(), title=gettext(
                            "%(fee_kind)s (Category: %(category)s, Budget: %(budget)s)")|format(
                                fee_kind=gettext(fee.kind|string), category=gettext(fee.kind.category|string), budget=gettext(fee.kind.budget|string))) -}}
                </td>
                <td id="eventfee-title-{{ fee.id }}" {% if fee.notes %}title="{{ fee.notes }}"{% endif %}
                        class="active-fee-title {% if not js_preview and complex_fee %}
                            {{ "alert-success" if fee.id in complex_fee.active_fees else "alert-danger" }}
                        {% endif %}">
                    {% if js_preview %}
                        {{ util.deko_checkbox(
                                True, titles=[gettext("Inactive"), gettext("Active")], anid="checkbox-active") }}
                        {{ util.deko_checkbox(
                                False, titles=[gettext("Inactive"), gettext("Active")], anid="checkbox-inactive") }}
                    {% elif complex_fee %}
                        {{ util.deko_checkbox(
                                fee.id in complex_fee.active_fees, titles=[gettext("Inactive"), gettext("Active")]) }}
                    {% endif %}
                    {% if not js_preview and not complex_fee %}
                        <strong>
                            {{ fee.title }}
                        </strong>
                        {%- if fee.notes %}
                            <br />
                            {{ fee.notes }}
                        {% endif %}
                    {% else %}
                        {{ fee.title }}
                        {%- if fee.notes %}{{ nbsp -}}
                            <span class="float-right">
                                {{- util.make_icon("tag") -}}
                            </span>
                        {%- endif %}
                    {% endif %}
                </td>
                {% if fee.amount is not none %}
                    {{ _fee_amount_td(fee.amount, fee.id) }}
                    {% if complex_fee %}
                        <td></td>
                    {% endif %}
                {% elif js_preview %}
                    {% if ambience['registration'] and fee.id in ambience['registration']['personalized_fees'] %}
                        {{ _fee_amount_td(ambience['registration']['personalized_fees'][fee.id], fee.id) }}
                    {% else %}
                        {{ _fee_amount_td(None, fee.id) }}
                    {% endif %}
                {% elif complex_fee %}
                    {% if fee.id in ambience['registration']['personalized_fees'] %}
                        {{ _fee_amount_td(ambience['registration']['personalized_fees'][fee.id], fee.id) }}
                        <td>
                            <form action="{{ cdedblink("event/delete_personalized_fee", {'fee_id': fee.id}) }}"
                                  method="POST" id="deletepersonalizedfeeform{{ fee.id }}">
                                {{ util.anti_csrf_token("event/delete_personalized_fee") }}
                                {{ util.input_submit(
                                        icon='minus', label=None, aclass="btn btn-xs btn-danger",
                                        readonly=not is_privileged_for('delete_personalized_fee') or ambience['event'].is_balanced,
                                        title=(
                                            gettext("Event is balanced. May not set personalized fee amount.")
                                            if ambience['event'].is_balanced else
                                            ""
                                        )) }}
                            </form>
                        </td>
                    {% else %}
                        <form action="{{ cdedblink("event/add_personalized_fee", {'fee_id': fee.id}) }}"
                              method="POST" id="addpersonalizedfeeform{{ fee.id }}">
                            {{ util.anti_csrf_token("event/add_personalized_fee") }}
                            <td class="text-right">
                                {% call util.output_errors("amount" + fee.id|string, wrapper=True) %}
                                    {{ util.input_text("amount" + fee.id|string, type="number", placeholder="",
                                                       aclass="form-control float-right no-number-arrows",
                                                       attributes='style="width:5em" step="0.01"'|safe) }}
                                {% endcall %}
                            </td>
                            <td>
                                {{ util.input_submit(
                                        icon='plus', label=None, aclass="btn btn-xs btn-success",
                                        readonly=not is_privileged_for('add_personalized_fee') or ambience['event'].is_balanced,
                                        title=(
                                            gettext("Event is balanced. May not set personalized fee amount.")
                                            if ambience['event'].is_balanced else
                                            ""
                                        )) }}
                            </td>
                        </form>
                    {% endif %}
                {% else %}
                    {{ _fee_amount_range_td(fee) }}
                {% endif %}
                {% if not js_preview and not complex_fee %}
                    <td class="nowrap">
                            {{ active_fee_registration_query_link(
                                fee_stats[fee.kind][fee.id].registrations_owed, gettext("Owed"), fee_id=fee.id,
                                anid="eventfee_owed_" + fee.id|string) }}:
                        <br />
                            {{ active_fee_registration_query_link(
                                    fee_stats[fee.kind][fee.id].registrations_paid, gettext("Paid"), fee_id=fee.id,
                                    anid="eventfee_paid_" + fee.id|string) }}:
                    </td>
                    <td class="nowrap" style="padding-left: 0">
                        <span class="float-right" id="eventfee_total_owed_{{ fee.id }}">
                            {{ _print_fee_amount(fee_stats[fee.kind][fee.id].total_owed) }}
                        </span>
                        <br />
                        <span class="float-right" id="eventfee_total_paid_{{ fee.id }}">
                            {{ _print_fee_amount(fee_stats[fee.kind][fee.id].total_paid) }}
                        </span>
                    </td>
                {% endif %}
                <td class="active-fee-condition nowrap {{ "eventfee-personalized" if not fee.condition else "" }} {{ aclass }}"
                        title="{{ atitle }}"
                        id="eventfee_condition_{{ fee.id }}">
                    {% for icon, icon_title in format.icons %}
                        {{ util.make_icon(icon, icon_title) }}
                    {% endfor %}
                    {% if not fee.condition %}
                        <i>
                            {% trans %}Personalized Fee{% endtrans %}
                        </i>
                        {% if js_preview or complex_fee %}
                            {% if fee.amount_min is not none %}
                                ({{ _print_fee_amount_range(fee) }})
                            {% endif %}
                        {% else %}
                            {{ util.href(
                                    cdedblink("event/personalized_fee_multiset", {'fee_id': fee.id}),
                                    anid="personalized_fee{}_multiset".format(fee.id),
                                    label=None, icon="calculator", aclass="btn btn-sm btn-warning float-right",
                                    readonly=not is_privileged_for('personalized_fee_multiset') or ambience['event'].is_balanced,
                                    title=(
                                        gettext("Event is balanced. May not change fee configuration.")
                                        if ambience['event'].is_balanced else
                                        gettext("Set personalized amount for multiple registrations.")
                                    )) }}
                        {% endif %}
                    {% elif complex_fee %}
                        {{ complex_fee.visual_debug[fee.id]|safe }}
                    {% else %}
                        {{ fee.visual_debug|safe }}
                    {% endif %}
                </td>
                {% if not js_preview %}
                    <td class="nowrap b-left">
                        {% if complex_fee %}
                            {{ util.href(cdedblink("event/fee_summary") + "#eventfee_{}".format(fee.id), label=None,
                                         title=gettext("Go to event fee summary"), icon="chevron-right",
                                         aclass="btn btn-xs btn-info") }}
                        {% else %}
                            {{ util.href(
                                    cdedblink("event/configure_fee_form", {'fee_id': fee.id}), label=util.make_icon("pen"),
                                    anid="eventfee{}_change".format(fee.id), aclass="btn btn-sm btn-warning",
                                    readonly=not is_privileged_for('configure_fee_form') or ambience['event'].is_balanced,
                                    title=(
                                        gettext("Event is balanced. May not change fee configuration.")
                                        if ambience['event'].is_balanced else
                                        gettext("Change fee %(fee_title)s")|format(fee_title=fee['title'])
                                    )) }}
                            <form action="{{ cdedblink("event/delete_fee", {'fee_id': fee.id}) }}"
                                  method="POST" id="deleteeventfeeform{{ fee.id }}" class="display-inline">
                                {{ util.anti_csrf_token("event/delete_fee") }}
                                {{ util.input_submit(
                                        icon='trash-alt' if fee.amount is not none else 'dumpster-fire',
                                        label=None, aclass="btn btn-sm btn-danger",
                                        readonly=not is_privileged_for('delete_fee') or ambience['event'].is_balanced,
                                        title=(
                                            gettext("Event is balanced. May not change fee configuration.")
                                            if ambience['event'].is_balanced else
                                            gettext("Delete fee %(fee_title)s")|format(fee_title=fee['title'])
                                        )) }}
                            </form>
                        {% endif %}
                    </td>
                {% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endmacro %}

{% macro fee_preview_panel(show_composition=False, hideable=False) %}
    <div class="panel panel-primary">
        <div class="panel-body">
            <noscript>
                {% trans %}
                    Activate JavaScript for automatic fee preview.
                {% endtrans %}
            </noscript>
            {% if hideable %}
                <details>
                    <summary>
                        <strong>
                            {% trans %}Fee Preview{% endtrans %}
                        </strong>
                    </summary>
            {% endif %}
            <div id="fee-preview" style="display: none">
                {% if caller %}
                    {{ caller() }}
                {% endif %}
                {{ util.form_input_static(label=gettext("Fee"), anid="fee-amount", value="…") }}
            </div>
            {% if show_composition %}
                {{ fee_composition_table(js_preview=True) }}
            {% endif %}
            {% if hideable %}
                </details>
            {% endif %}
        </div>
    </div>
{% endmacro %}


{#  Print a breakdown of the fee composition for registration status and preview during registration.

    Skip fee kinds that sum to zero, unless `show_all=True`.
#}
{% macro fee_breakdown_by_kind(complex_fee, show_all=False) -%}
    <table id="fee-breakdown" class="table-slim table-condensed bg-info" style="color: #333">
        <tbody>
            {# Already sorted automatically. #}
            {% for kind, amount in complex_fee if amount or show_all %}
                <tr>
                    <td style="padding-right: 1em">
                        {{ gettext(kind|string) }}
                    </td>
                    <td class="text-right">
                        {{ amount|money(lang=lang) }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr class="summary">
                <td>
                    {% trans %}Total{% endtrans %}
                </td>
                <td class="text-right">
                    {{ complex_fee.amount|money(lang=lang) }}
                </td>
            </tr>
        </tfoot>
    </table>
{%- endmacro %}


{# If no registration id is given, it will be filled in from the ambience. #}
{% macro registration_fee_qr(registration_id=None) %}
    {% set params = {} %}
    {% if registration_id %}
        {% do params.update(registration_id=registration_id) %}
    {% endif %}
    {{ util.href(cdedblink('event/registration_fee_qr', params), label=gettext("QR"),
                 icon='qrcode', aclass="btn btn-xs btn-default pull-right", anid="show-registration-fee-qr",
                 title=gettext("Bank transfer data as QR code")) }}
    <script nonce="{{ csp_nonce }}">
        $("#show-registration-fee-qr").cdedbQRCodeModal(
            {{ {'title': ambience['event']['title'],
                'loading': gettext("Loading..."),
                'note': "",
                'close': gettext("Close") }|tojson }})
    </script>
{% endmacro %}


{% macro edit_free_text_button(key, label=gettext("Edit"), display=True, small=True, pull_right=True) %}
    {% if is_privileged_for("change_free_text") %}
        {{ util.href(
            cdedblink("event/show_free_texts", {'edit': key}), label=label, icon="pen", anid=key + '-edit',
            aclass="btn btn-warning" + (" btn-xs" if small else " btn-sm") + (" pull-right" if pull_right else ""),
            attributes=('style="color: #fff;' + ('' if display else 'display: none;') + '"')|s) }}
    {% endif %}
{% endmacro %}


{% macro filter_violations(endpoint, resultsid, filter_severity=True, filter_event=True, event_options=[]) %}

    {% call util.bootstrap_panel(gettext("Filter"), aclass="panel-primary", icon="filter") %}
        <form action="{{ cdedblink(endpoint) }}" method="GET" id="filterconstraintsform" class="form-horizontal">
            {% if filter_severity %}
                {{ util.form_input_select(name="min_severity", label=gettext("Minimum Inconsistency Severity"),
                                          anid="filter-min-severity", defaultvalue=min_severity,
                                          entries=enums['ViolationSeverity']|enum_entries(gettext)) }}
                {{ util.form_input_select(name="violation_kind", label=gettext("Type of Inconsistency"),
                                          anid="filter-violation-kind", defaultvalue=violation_kind,
                                          nulloption=gettext(gettext("All")),
                                          entries=enums['ViolationKind']|enum_entries(gettext)) }}
            {% endif %}
            {% if filter_event %}
                {{ util.form_input_text(label=gettext("Only show these events:"), name="event_ids", anid="filter-event-ids",
                                        placeholder=gettext("<id>,<id>,…")) }}
                {% set tristate_entries = [(-1, gettext("any")), (0, gettext("no")), (1, gettext("yes"))] %}
                {% set col_class = "col-sm-3 mosp" %}
                <div class="row">
                    <div class="col-sm-1"></div>
                    <div class="{{ col_class }}">
                        <label>{% trans %}Is Archived{% endtrans %}</label>
                        {{ util.input_checkboxes("is_archived", tristate_entries, radio=true, defaultvalue="-1") }}
                    </div>
                    <div class="{{ col_class }}">
                        <label>{% trans %}Is Balanced{% endtrans %}</label>
                        {{ util.input_checkboxes("is_balanced", tristate_entries, radio=true, defaultvalue="-1") }}
                    </div>
                    <div class="{{ col_class }}">
                        <label>{% trans %}Is Concluded{% endtrans %}</label>
                        {{ util.input_checkboxes("is_concluded", tristate_entries, radio=true, defaultvalue="-1") }}
                    </div>
                    {{ util.input_submit(label=gettext("Filter"), icon="search", aclass="btn btn-primary float-bottomright") }}
                </div>
            {% else %}
                {{ util.form_input_submit(label=gettext("Filter"), icon="search", aclass="btn btn-primary float-right") }}
            {% endif %}
        </form>

        {% if not jshint %}
            {{ util.raise_for_test("jshint not set for 'util.filter_violations'.") }}
        {% endif %}
        <script nonce="{{ csp_nonce }}">
            $("#filterconstraintsform").cdedbFilterViolations(
                "#{{ resultsid }}",
                {{ event_options|tojson }},
                {{ enums['ViolationSeverity'].map()|tojson }},
                {{ enums['ViolationKind'].map()|tojson }},
            );
        </script>
    {% endcall %}
{% endmacro %}
