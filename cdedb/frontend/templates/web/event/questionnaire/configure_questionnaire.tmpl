{% set sidenav_active = "event_quest_config" %}
{% extends "web/event/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}
{% set jshint="strong" %}
{% import "web/generic.tmpl" as generic with context %}
{% import "web/event/generic.tmpl" as generic_event with context %}
{% block scripts %}
    {{ super() }}
    {{ util.cdedb_script("cdedb_helper.js") }}
    {{ util.cdedb_script("cdedb_dynamicrow.js") }}
    {{ util.cdedb_script("cdedb_questionnaire_config.js") }}
    {{ util.cdedb_script('cdedb_tabs.js') }}
{% endblock %}
{% block title %}
    {% trans title=ambience["event"].title %}
        Configure Questionnaires ({{ title }})
    {% endtrans %}
{% endblock %}
{% block breadcrumb %}
    {{ super() }}
    {{ util.breadcrumb_link(cdedblink("event/show_event"), ambience["event"].title, icon="chalkboard-teacher") }}
    {{ util.breadcrumb_link(cdedblink("event/configure_questionnaire_form"), gettext("Configure Questionnaires"), active=True) }}
{% endblock %}
{% block heading %}
    {{ util.context_heading(gettext("Configure Questionnaires"), ambience["event"].title,
                            "chalkboard-teacher", gettext("Event")) }}
{% endblock %}


{% block content %}
    <div class="p button-par">
        {{ util.href(cdedblink("event/reorder_questionnaire_form"), gettext("Reorder Questionnaires"),
                     aclass="btn btn-warning btn-sm", icon=enums["QuestionnaireUsages"].get_sort_icon(),
                     readonly=not is_privileged_for("reorder_questionnaire_form")) }}
        {{ util.href(cdedblink("event/questionnaire_import_form"), gettext("Questionnaire Import"),
                     aclass="btn btn-warning btn-sm", icon="file-upload",
                     readonly=not is_privileged_for("questionnaire_import_form")) }}
        {{ util.href(
                cdedblink("event/register_form", {"preview": True}), gettext("Registration Preview"),
                aclass="btn btn-info btn-sm", icon=enums["QuestionnaireUsages"].registration.get_preview_icon()) }}
        {{ util.href(
                cdedblink("event/additional_questionnaire_form", {"preview": True}), gettext("Questionnaire Preview"),
                aclass="btn btn-info btn-sm", icon=enums["QuestionnaireUsages"].additional.get_preview_icon()) }}
    </div>
    {% if ambience['event'].questionnaire_notes %}
        {% call util.bootstrap_panel(title=gettext("Questionnaire Notes") + nbsp + generic_event.edit_free_text_button("questionnaire_notes"),
                                     icon="tag", aclass="panel-default panel-condensed", footer_class="text-info", footer_icon="info-circle",
                                     footer_text=gettext('Shown to orgas on the "Configure Questionnaires" page.')) %}
            <div id="questionnaire-notes">{{ ambience['event'].questionnaire_notes|md }}</div>
        {% endcall %}
    {% endif %}

    {% set nav_tabs = {} %}
    {% for kind in enums["QuestionnaireUsages"] %}
        {% do nav_tabs.__setitem__(kind, {
                "target": "#tab_" + kind.name,
                "label": gettext(kind|string),
                "icon": kind.get_icon(),
                "anid": kind.name + "_tab",
            }) %}
    {% endfor %}


    <form action="{{ cdedblink("event/configure_questionnaire") }}" method="POST"
          id="configurequestionnaireform" class="protect">
        {{ util.anti_csrf_token("event/configure_questionnaire") }}
        {% call generic.tabs("usages", nav_tabs.values()) %}
            {{ util.input_hidden("nav_tab_active") }}
            {% for kind, tab_data in nav_tabs.items() %}
                {% call generic.tab_pane(
                        tab_data["target"][1:],
                        tab_data["anid"],
                        util.make_icon(tab_data["icon"]) + nbsp + tab_data["label"]
                    ) %}

                    {{ util.output_errors(drow_basename("questionnaire", kind.name), wrapper=True) }}

                    <div id="drow-container-{{ kind.name }}">
                        {# Old items, already stored in the database #}
                        {% for entry in all_questionnaires[kind] %}
                            {{ generic_event.questionnaire_config_entry(loop.index0, kind, aclass="drow-row") }}
                        {% endfor %}

                        {# Items that were added by the user but failed validation. They are still new and have no official id. #}
                        {% for i in range(1, values.get(drow_last_index(kind.name), 0) + 1) %}
                            {{ generic_event.questionnaire_config_entry(-i, kind, aclass="drow-new", newrow=True) }}
                        {% endfor %}

                        {# Prototype row. For non-JS users: an empty row with 'create'-checkbox, for JS: prototype for new rows. #}
                        {{ generic_event.questionnaire_config_entry(
                                -values.get(drow_last_index(kind.name), 0) - 1, kind=kind,
                                aclass="drow-prototype", newrow=True
                            ) }}
                        <p>
                            <button type="button" class="btn btn-success softhide pull-right" id="drow-addbutton-{{ kind.name }}">
                                {{ util.make_icon("plus") }} {% trans %}Add Part{% endtrans %}
                            </button>
                        </p>
                    </div>

                    {{ util.input_submit(name="submitted_kind", value=kind, label=gettext("Save"),
                            readonly=not is_privileged_for("event/configure_questionnaire")) }}

                    <script type="text/javascript" nonce="{{ csp_nonce }}">
                        (function() {
                            let field_list = {{ all_questionnaires[kind].get_available_fields()|tojson }};
                            let classes_by_role = {{ drow_classes_by_role|tojson }};
                            let all_classes = {{ all_drow_classes|tojson }};
                            let translations = {
                                "true": "{{ gettext("true") }}",
                                "false": "{{ gettext("false") }}",
                            };
                            $("#drow-container-{{ kind.name }}").cdedbDynamicRow(
                                {
                                    addButton: $("#drow-addbutton-{{ kind.name }}"),
                                    callback: function () {
                                        $(this).cdedbQuestionnaireConfig(field_list, translations, classes_by_role, all_classes);
                                    },
                                    delButtonTitle: "{{ gettext("Delete Questionnaire Part") }}"
                                });
                            $(".drow-row,.drow-new").cdedbQuestionnaireConfig(field_list, translations, classes_by_role, all_classes);
                        })()
                    </script>
                {% endcall %}
            {% endfor %}
        {% endcall %}

        {{ util.input_hidden("checksum", value=checksum) }}
    </form>
    <script type="text/javascript" nonce="{{ csp_nonce }}">
        $("form.protect").cdedbProtectChanges();
    </script>
{% endblock %}
