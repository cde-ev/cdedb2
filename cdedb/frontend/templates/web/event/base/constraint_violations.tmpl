{% set sidenav_active = 'event_constraint_violations' %}
{% extends "web/event/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}
{% set jshint = 'weak' %}
{% import "web/event/generic.tmpl" as generic with context %}
{% block scripts %}
    {{ super() }}
    {{ util.cdedb_script('cdedb_filter_violations.js') }}
{% endblock %}
{% block title %}
    {{ ambience['event']['title'] }} – {% trans %}Inconsistencies{% endtrans %}
{% endblock %}
{% block breadcrumb %}
    {{ super() }}
    {{ util.breadcrumb_link(cdedblink("event/show_event"), ambience['event']['title'], icon='chalkboard-teacher') }}
    {{ util.breadcrumb_link(cdedblink("event/constraint_violations"), gettext("Inconsistencies"), active=True) }}
{% endblock %}
{% block heading %}
    {{ util.context_heading(gettext("Inconsistencies"), ambience['event']['title'], 'chalkboard-teacher', gettext("Event")) }}
{% endblock %}
{% block content %}
    {% if violations %}
        {{ generic.filter_violations("event/constraint_violations", "violations", filter_event=False) }}

        <div id="violations">
            <div id="event_{{ ambience['event'].id }}" class="event">
                {% for class_name, violation_list in violations.by_class.items() %}
                    <div class="violation-list maybehide">
                        {{ util.doclink_("Handbuch_Orga_Verstöße", class_name|lower) }}
                        {{ util.h(class_name, underline=true) }}
                        {{ generic.list_violations(class_name, violation_list, entity_page="", min_severity=min_severity, violation_kind=violation_list[0].kind) }}
                    </div>
                {% endfor %}
                <div class="maybenothide text-muted">
                    {% trans %}
                        There are currently no inconsistencies matching the filter.
                    {% endtrans %}
                </div>
            </div>
        </div>
    {% else %}
        <div class="text-muted">
            {% trans %}
                There are currently no inconsistencies.
            {% endtrans %}
        </div>
    {% endif %}
{% endblock %}
