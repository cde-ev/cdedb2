{% set sidenav_active='event_fees' %}
{% extends "web/event/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}
{% import "web/event/generic.tmpl" as generic_event with context %}
{% block title %}
    {% trans title=ambience['event']['title'] %}
        Fees ({{ title }})
    {% endtrans %}
{% endblock %}
{% block heading %}
    {{ util.doclink_("Handbuch_Orga_Teilnahmebeitraege") }}
    {{ util.context_heading(gettext("Fees"), ambience['event']['title'], 'chalkboard-teacher', gettext("Event")) }}
{% endblock %}
{% block breadcrumb %}
    {{ super() }}
    {{ util.breadcrumb_link(cdedblink("event/show_event"), ambience['event']['title'], icon="chalkboard-teacher") }}
    {{ util.breadcrumb_link(cdedblink("event/fee_summary"), gettext("Fees"), active=True) }}
{% endblock %}

{% block content %}
    <div class="p button-par">
        {{ util.href(cdedblink('event/configure_fee_form', {'personalized': False}), gettext("Add Conditional Fee"),
                               icon='plus', aclass='btn btn-success btn-sm',
                               readonly=not is_privileged_for('configure_fee_form') or ambience['event'].is_balanced,
                               title=gettext("Event is balanced. May not change fee configuration.") if ambience['event'].is_balanced else "") }}
        {{ util.href(cdedblink('event/configure_fee_form', {'personalized': True}), gettext("Add Personalized Fee"),
                               icon='plus', aclass='btn btn-success btn-sm',
                               readonly=not is_privileged_for('configure_fee_form') or ambience['event'].is_balanced,
                               title=gettext("Event is balanced. May not change fee configuration.") if ambience['event'].is_balanced else "") }}
        {{ util.href(cdedblink('event/fee_stats'), gettext("Fee Stats"),
                               icon='chart-bar', aclass='btn btn-info btn-sm') }}
        {{ util.href(cdedblink('event/batch_fees_form'), gettext("Enter Money Transfers"),
                               icon='euro-sign', aclass="btn btn-info btn-sm",
                               readonly=not is_privileged_for('batch_fees_form') or ambience['event'].is_balanced,
                               title=gettext("Event is balanced. May not book payments.") if ambience['event'].is_balanced else "") }}
        {{ util.href(cdedblink("event/part_summary"), gettext("Event Parts"), icon='clock', aclass='btn btn-default btn-sm') }}
    </div>

    {{ generic_event.fee_composition_table() }}
{% endblock %}
