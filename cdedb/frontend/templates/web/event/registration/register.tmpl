{% set sidenav_active = "event_quest_config" if preview else "event_register" %}
{% set jshint = 'strong' %}
{% extends "web/event/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}
{% import "web/event/generic.tmpl" as generic_event with context %}
{% block scripts %}
    {{ super() }}
    {{ util.cdedb_script('cdedb_helper.js') }}
    {{ util.cdedb_script('cdedb_register.js') }}
{% endblock %}
{% block title %}
    {% if preview %}
        {% trans title=ambience['event']['title'] %}
            Registration Preview for {{ title }}
        {% endtrans %}
    {% else %}
        {% trans title=ambience['event']['title'] %}
            Registration for {{ title }}
        {% endtrans %}
    {% endif %}
{% endblock %}
{% block breadcrumb %}
    {{ super() }}
    {{ util.breadcrumb_link(cdedblink("event/show_event"), ambience['event']['title'], icon="chalkboard-teacher",
                            readonly=not (ambience['event'].is_visible_for(user, is_registered=False, privileged=False)
                                          or orga_view or user.admin_views.has(AdminViews.event_mgmt))) }}
    {% if preview %}
        {{ util.breadcrumb_link(
                cdedblink("event/configure_questionnaire_form") + "#tab_" + kind.name,
                gettext("Configure Questionnaires")) }}
        {{ util.breadcrumb_link(cdedblink("event/register", {"preview": True}),
                                gettext("Registration Preview"), active=True) }}
    {% else %}
        {{ util.breadcrumb_link(cdedblink("event/register"), gettext("Register"), active=True) }}
    {% endif %}
{% endblock %}

{% block heading %}
    {{ util.context_heading(gettext("Registration Preview") if preview else gettext("Registration"),
                            ambience['event']['title'], 'chalkboard-teacher', gettext("Event")) }}
{% endblock %}

{% macro button_par() %}
    {% if is_privileged_for("event/configure_questionnaire_form") %}
        <div class="p button-par">
            {{ util.href(
                    cdedblink("event/configure_questionnaire_form") + "#tab_" + kind.name, gettext("Configure Registration"),
                    aclass="btn btn-sm btn-warning", icon=kind.get_edit_icon()) }}
            {{ util.href(cdedblink("event/reorder_questionnaire_form") + "#tab_" + kind.name, gettext("Reorder Registration"),
                         aclass="btn btn-warning btn-sm", icon=kind.get_sort_icon(),
                         readonly=not is_privileged_for("reorder_questionnaire_form")) }}
            {% if not preview %}
                {{ util.href(
                        cdedblink("event/register_form", {"preview": True}), gettext("Registration Preview"),
                        aclass="btn btn-info btn-sm", icon=kind.get_preview_icon()) }}
            {% endif %}
            {{ util.href(
                    cdedblink("event/additional_questionnaire_form", {"preview": True}), gettext("Questionnaire Preview"),
                    aclass="btn btn-info btn-sm", icon=enums["QuestionnaireUsages"].additional.get_preview_icon()) }}
        </div>
    {% endif %}
{% endmacro %}

{% block static_notifications %}
    {{ super() }}
    {% if ambience['event']['institution'] == enums["PastInstitutions"].private %}
        {% call util.notification('warning', id='is_private') %}
            {% trans %}This event is not organized under the supervision of CdE, but independently by the Orgas.{% endtrans %}
        {% endcall %}
    {% endif %}
{% endblock %}

{% block content %}
    {{ button_par() }}
    <p>
        {% if ambience['event']['registration_soft_limit'] is none %}
            {% trans %}
                All data except Event Parts can be changed until the registration ends.
            {% endtrans %}
        {% elif ambience['event']['registration_soft_limit'] >= now() %}
            {% trans date=ambience['event']['registration_soft_limit']|datetime(lang=lang) %}
                All data except Event Parts can be changed until the registration ends ({{ date }}).
            {% endtrans %}
        {% else %}
            {% trans %}
                The official registration has ended. Your registration will be considered if possible.
            {% endtrans %}
        {% endif %}
    </p>

    <form action="{{ cdedblink('event/register') }}" method="POST" id="registerform" class="form-horizontal protect">
    {% if not preview %}
        {{ util.anti_csrf_token('event/register') }}
    {% endif %}

        <div id="registrationquestionnaire">
            {% for entry in questionnaire %}
                {{ generic_event.print_questionnaire_entry(entry, is_locked) }}
            {% endfor %}
        </div>

        {% call util.form_input_general(displayerrors=False) %}
            {% if ambience['event'].use_additional_questionnaire %}
                <p class="text-info nosp">
                    {{ util.make_icon('info-circle') }}
                    {% trans %}
                        After registration, you will find the ‘Questionnaire’ with further questions of the orga team in
                        the navigation. There you can give more detailed information.
                    {% endtrans %}
                </p>
            {% else %}
                <p class="text-info nosp">
                    {{ util.make_icon('info-circle') }}
                    {% trans %}
                        The orga team of this event may ask you for further data later, using the ‘Questionaire’.
                    {% endtrans %}
                </p>
            {% endif %}
        {% endcall %}

        {% if preview %}
            {% call generic_event.fee_preview_panel(show_composition=preview) %}
                {{ util.form_input_checkbox("is_orga", gettext("Is Orga"), anid="fee-precompute-is-orga") }}
                {{ util.form_input_checkbox("is_member", gettext("Is Member"), anid="fee-precompute-is-member",
                                            defaultvalue="True") }}
                {{ util.form_input_text("age", gettext("Age"), type="number", anid="fee-precompute-age",
                                        defaultvalue=persona_age) }}
            {% endcall %}
        {% endif %}

        {% if not preview %}
            {% if age_class.with_guardian() %}
                {{ util.form_input_static(
                        aclass='text-info', icon='info-circle', anid="minor-with-guardian",
                        value=gettext("I confirm that I will attend the event only under the supervision of a parent who will attend the same event.")) }}
            {% endif %}
            {{ util.form_input_submit(label=gettext("Register"), cancellink=cdedblink('event/show_event')) }}
        {% endif %}
    </form>

    {% if button_par().strip() %}
        <hr />
    {% endif %}
    {{ button_par() }}

    <script nonce="{{ csp_nonce }}">
        var $form = $('#registerform');

        ccos_per_part = {{ ccos_per_part|tojson }};
        part_map = {{ parts_per_track_group_per_course|tojson }};

        feePreviewConstants = {
            'endpoint': '{{ cdedblink('event/precompute_fee') }}',
            'persona_id': '{{ user.persona_id|cdedbid if not preview else "" }}',
            'is_member': {{ persona['is_member']|tojson }},
            'is_orga': {{ (ambience['event']['id'] in user.orga)|tojson }},
            'age': {{ persona_age }},
            'part_ids': {{ (ambience['event'].parts|list if ambience['event'].parts|length <= 1 else None)|tojson }},
        }

        $form
            .dynamicCourseChoices(ccos_per_part, part_map)
            .cdedbFeePreview(feePreviewConstants);
    </script>
{% endblock %}
