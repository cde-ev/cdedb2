{% extends "web/core/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}
{% block title %}
    {% trans name=ambience['persona']|persona_name %}
        {{ name }} – Event Data
    {% endtrans %}
{% endblock %}
{% block breadcrumb %}
    {{ super() }}
    {{ util.breadcrumb_link(show_user_link(user, ambience['persona']['id']), ambience['persona']|persona_name,
                            icon="user") }}
    {{ util.breadcrumb_link(cdedblink("core/show_user_events"), gettext("Show Event Data"), active=True) }}
{% endblock %}
{% block heading %}
    {{ util.context_heading(gettext("Event Data"), ambience['persona']|persona_name, 'user', gettext("User")) }}
{% endblock %}

{% block static_notifications %}
    {% if ambience['persona']['is_archived'] %}
        {% call util.notification('info', id='archived') %}
            {% trans %}The user is archived.{% endtrans %}
        {% endcall %}
    {% endif %}
{% endblock %}

{% block content %}
    {% if is_event_helper %}
        {{ util.h(gettext("Event Helper"), 3) }}
        <p>
            {% trans %}
                The user is Event Helper.
            {% endtrans %}
        </p>
    {% endif %}

    {% if special_role_events %}
        {{ util.h(gettext("Event Specific Roles"), 3) }}
        <div id="event-roles-list">
            <ul>
                {% for event in events.values()|reverse if event.id in special_role_events %}
                    <li>
                        {{ util.href(
                                cdedblink("event/show_event", {"event_id": event.id}), event.title,
                                readonly=not event.is_visible_for(user, False, privileged=False)
                            ) }}:
                        {% set roles = [] %}
                        {% if event.id in orga_events %}{% do roles.append(gettext("Orga")) %}{% endif %}
                        {% if event.id in caretaker_events %}{% do roles.append(gettext("Caretaker")) %}{% endif %}
                        {% if event.id in checkin_helper_events %}{% do roles.append(gettext("Checkin Helper")) %}{% endif %}
                        {{ roles|join(", ") }}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if registration_ids %}
        {{ util.h(gettext("Registrations"), 3) }}
        <div id="registration-list">
            <p>
                {% trans %}
                    This lists all events which have not been deleted yet and this user has a registration for.
                {% endtrans %}
            </p>
            <ul>
                {% for event in events.values()|reverse if event.id in registration_ids %}
                    <li>
                        {% if ambience['persona'].id == user.persona_id %}
                            {{ util.href(cdedblink("event/registration_status", {'event_id': event.id}), event['title']) }}
                        {% elif is_privileged(event.id, EP.registrations_read, EP.checkin) %}
                            {{ util.href(
                                    cdedblink(
                                        "event/show_registration",
                                        {'event_id': event.id, 'registration_id': registration_ids[event.id]}
                                    ),
                                    event['title']
                                ) }}
                        {% else %}
                            {{ util.href(
                                    cdedblink("event/show_event", {"event_id": event.id}), event.title,
                                    readonly=not event.is_visible_for(user, False, privileged=False)
                                ) }}
                        {% endif %}
                        <br />
                        <small class="text-muted">
                        {% for part in event['parts'].values()|sort %}
                            {% if registration_parts[event.id]|length != 1 %}
                                {{ event['parts'][part.id]['title'] }}:
                            {% endif %}
                            {{ gettext(registration_parts[event.id][part.id]|enum(enums['RegistrationPartStati'])) }}
                            {%- if not loop.last %}, {% endif -%}
                        {% endfor %}
                        </small>
                    </li>
                {% else %}
                    <p class="text-muted">{% trans %}This user has no registrations.{% endtrans %}</p>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endblock %}
