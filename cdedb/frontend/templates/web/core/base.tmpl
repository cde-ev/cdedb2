{% set mainnav_active='core' %}
{% extends "web/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}
{% block breadcrumb %}
    {{ util.breadcrumb_link(cdedblink("core/index"), "Index") }}
{% endblock %}

{% block base_scripts %}
    {% if "core_user" in user.admin_views or "meta_admin" in user.admin_views %}
        {{ util.cdedb_script('cdedb_searchpersona.js') }}
    {% endif %}
{% endblock %}

{% macro persona_quicksearch(mobile=false) %}
    <div class="list-group tear-down
            {% if mobile %}hidden-md hidden-lg{% elif mobile is sameas false %}hidden-xs hidden-sm{% endif %}
    ">
        {% set form_id = "quickpersonasearch" + ("-mobile" if mobile is not sameas false else "") %}
        <form action="{{ cdedblink("core/admin_show_user") }}" method="GET" id="{{ form_id }}">
            <div class="sr-only">{% trans %}Search for Users by ID or Name{% endtrans %}</div>
            <div class="input-group">
                {{ util.input_text(type="search", name="phrase", placeholder=gettext("CdEDB-ID, Name or E-Mail")) }}
                <span class="input-group-btn">
                    {{ util.input_submit("", icon='search', title=gettext("Search")) }}
                </span>
            </div>
        </form>
        <script nonce="{{ csp_nonce }}">
            form = $("#{{ form_id }}");
            // Adjust input group styling.
            igroup = form.find(".input-group");
            igroup.children(".input-group-btn").remove();
            igroup.replaceWith(igroup.contents());
            // Add selectize.
            form
                .find(":input")
                .cdedbSearchPerson(
                    "{{ cdedblink("core/select_persona") }}",
                    {"kind": "admin_persona"},
                    [],  // exclude
                    true,  // free-form
                    false,  // multi
                )
                .on("change", function() {
                    if ($(this).val()) {
                        $(this).closest("form").submit();
                    }
                });

        </script>

    </div>
{% endmacro %}

{% block navigation %}
    {% if "persona" in user.roles %}
        <h3 class="heading-sidebar">{% trans %}Index{% endtrans %}</h3>
        <div class="list-group tear-down">
            {{ util.href(cdedblink("core/index"), gettext("Overview"), aclass="list-group-item",
                    icon="caret-right", active=(sidenav_active=='core_index')) }}
            {{ util.href(cdedblink("core/mydata"), gettext("My Data"), aclass="list-group-item",
                    icon="user", active=(sidenav_active=='core_mydata')) }}
            {{ util.href(cdedblink("core/view_admins"), gettext("Admin Overview"), aclass="list-group-item",
                    icon="wrench", active=(sidenav_active=='core_admins')) }}
            {{ util.href(cdedblink("core/contact"), gettext("Contact"), aclass="list-group-item",
                    icon="at", active=(sidenav_active=='core_contact')) }}
        </div>
        {% if user.admin_views.intersection(("core_user", "user_review", "genesis", "meta_admin", "auditor", "ml_user")) %}
            {% if "core_user" in user.admin_views or "meta_admin" in user.admin_views %}
                {{ persona_quicksearch() }}
            {% endif %}
            <div class="list-group tear-down">
            {% if "core_user" in user.admin_views %}
                {{ util.href(cdedblink("core/user_search"), gettext("Manage Users"), aclass="list-group-item",
                        icon="users", active=(sidenav_active=='core_manage_users')) }}
            {% endif %}
            {% if "ml_user" in user.admin_views or "core_user" in user.admin_views %}
                {{ util.href(cdedblink("core/email_status_overview"), gettext("Defect Addresses"),
                        icon="user-friends", aclass="list-group-item", active=(sidenav_active == 'defect_addresses')) }}
            {% endif %}
            {% if 'user_review' in user.admin_views %}
                {{ util.href(cdedblink("core/list_pending_changes"), gettext("Pending Changes"), aclass="list-group-item",
                        icon="check-square", active=(sidenav_active=='core_pending_changes')) }}
            {% endif %}
            {% if "genesis" in user.admin_views %}
                {{ util.href(cdedblink("core/genesis_list_cases"), gettext("Account Requests"), aclass="list-group-item",
                        icon="door-open", active=(sidenav_active=='core_genesis_list')) }}
            {% endif %}
            {% if "meta_admin" in user.admin_views %}
                {{ util.href(cdedblink("core/list_privilege_changes"), gettext("Privilege Changes"), aclass="list-group-item",
                        icon="wrench", active=(sidenav_active=='core_privilege_changes')) }}
            {% endif %}
            {% if user.admin_views.intersection(('core_user', 'auditor')) %}
                {{ util.href(cdedblink("core/view_log"), gettext("Account Log"), aclass="list-group-item",
                        icon="far fa-list-alt", active=(sidenav_active=='core_log')) }}
                {{ util.href(cdedblink("core/view_changelog_meta"), gettext("Userdata Log"), aclass="list-group-item",
                        icon="far fa-list-alt", active=(sidenav_active=='core_change_log')) }}
            {% endif %}
            </div>
        {% endif %}
        {% if "complaint" in user.admin_views %}
            <div class="list-group tear-down">
                {% if "complaint_admin" in user.roles %}
                    {{ util.href(cdedblink("core/complaint_index"), gettext("Case Archive"), aclass="list-group-item",
                                 icon="gavel", active=(sidenav_active=='complaint_index')) }}
                {% endif %}
                {% if user.all_roles.intersection(["complaint_admin", "complaint.enforcer"]) %}
                    {{ util.href(cdedblink("core/measures"), gettext("Measure Overview"), aclass="list-group-item",
                                 icon="shield-halved", active=(sidenav_active=='show_measures')) }}
                {% endif %}
                {{ util.href(cdedblink("core/list_complaint_helpers"), gettext("Complaint Helpers"), aclass="list-group-item",
                             icon="handshake-angle", active=(sidenav_active=='complaint_helpers')) }}
                {% if "complaint_admin" in user.roles %}
                    {{ util.href(cdedblink("core/view_complaint_log"), gettext("Complaint Log"), aclass="list-group-item",
                            icon="far fa-list-alt", active=(sidenav_active=='complaint_log')) }}
                {% endif %}
            </div>
        {% endif %}
        {% if "core" in user.admin_views %}
            <div class="list-group tear-down">
                {{ util.href(cdedblink("core/meta_info_form"), gettext("Metadata"), aclass="list-group-item",
                             icon="tags", active=(sidenav_active=='core_meta')) }}
            </div>
        {% endif %}
        <hr class="strong visible-xs visible-sm" />
    {% endif %}
{% endblock %}

{% block adminviews %}
    {{ util.admin_views_toggle((
            (gettext("User Administration"), ["core_user", "cde_user", "event_user", "ml_user", "assembly_user"], ["core_user"]),
            (gettext("User Review"), ["user_review", "genesis"], None),
            (gettext("Admin Administration"), ["meta_admin"], None),
            (gettext("Core Administration"), ["core"], None),
            (gettext("Auditor"), ["auditor"], None),
            (gettext("Complaints"), ["complaint"], None),
        )) }}
{% endblock %}
