{% set sidenav_active='complaint_index' %}
{% extends "web/core/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}

{% block scripts %}
    {{ util.cdedb_script('cdedb_helper.js') }}
    {{ util.cdedb_script('cdedb_searchpersona.js') }}
{% endblock %}

{% set jshint = 'weak' %}

{% block title %}
    {% trans id=ambience['case'].id|string %}
        Case {{ id }}
    {% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {{ super() }}
    {{ util.breadcrumb_link(cdedblink("core/complaint_index"), gettext("Cases")) }}
    {{ util.breadcrumb_link(cdedblink("core/show_case"), gettext("Case %s")|format(ambience['case']['id']),
                            icon="gavel", active=True) }}
{% endblock %}


{% block content %}
    <div class="p button-par">
        {{ util.href(cdedblink('core/change_case'), gettext("Edit"),
                     aclass="btn btn-sm btn-warning", icon="pen") }}
        {{ util.href(cdedblink('core/view_complaint_log', {'case_id': ambience['case']['id']}),
                     gettext("View Log"), aclass="btn btn-sm btn-default", icon="list") }}
    </div>

    <dl class="dl-horizontal">
        <dt title="{% trans %}Summary{% endtrans %}">
            {% trans %}Summary{% endtrans %}
        </dt>
        <dd id="case-summary">
            {{ ambience['case'].summary }}
        </dd>
        <dt title="{% trans %}Kind{% endtrans %}">
            {% trans %}Kind{% endtrans %}
        </dt>
        <dd id="case-kind">
            {{ gettext(ambience['case'].kind|string) }}
        </dd>
        <dt title="{% trans %}is grave{% endtrans %}">
            {% trans %}is grave{% endtrans %}
        </dt>
        <dd>
            {{ util.deko_checkbox(checked=ambience['case']['is_grave'],
                                  titles=[gettext("No"),gettext("Yes")]) }}
        </dd>
        <dt title="{% trans %}Start Date{% endtrans %}">
        {% trans %}Start Date{% endtrans %}
        </dt>
        <dd>
            {{ ambience['case'].start_date|date(lang=lang) }}
        </dd>
        <dt title="{% trans %}End Date{% endtrans %}">
            {% trans %}End Date{% endtrans %}
        </dt>
        <dd >
            {{ ambience['case'].end_date|date(lang=lang) }}
        </dd>
    </dl>

    {{ util.h(n_("Relevant Individuals")) }}
    {#
    TODO
    {% if age_classes[persona.id] != enums['AgeClasses'].full %}
        <strong>({{ gettext(age_classes[persona.id]|string) }})</strong>
    {% endif %}
    #}

    {{ util.h(n_("Events_[[in a complaint]]")) }}
    <div class="p button-par">
        {{ util.href(cdedblink('core/add_entry_form'), gettext("Add standalone entry"),
                     aclass="btn btn-sm btn-success", icon="plus") }}
        <form action="{{ cdedblink("core/unlock_case") }}"
            method="POST"
            id="addentryform"
            class="display-inline"
        >
            {{ util.anti_csrf_token('core/unlock_case') }}
            {{ util.input_submit(label=gettext("Unlock"),
                                 aclass="btn btn-sm btn-primary",
                                 icon="unlock") }}
        </form>
    </div>

    <div class="list-group list-group-hover">
    {% for entry in all_entries %}
        {% if entry.entry_type %}
            <div id="entry{{ entry.id }}" class="list-group-item">
                <div class="float-right text-right">
                    <div style="margin-bottom: 5px;">
                        {{ entry.active_version.timestamp|datetime(lang=lang) }}
                    </div>
                    <div class="button-par">
                        {% if entry.entry_type.possible_children %}
                            {{ util.href(cdedblink('core/add_entry_form', {'parent_id': entry.id}),
                                         label="",
                                         title=gettext("Add child entry"),
                                         aclass="btn btn-xs btn-success",
                                         icon="forward-fast")
                            }}
                        {% endif %}
                        {{ util.href(cdedblink('core/replace_entry_form', {'entry_id': entry.id}),
                                     label="",
                                     title=gettext("Replace"),
                                     aclass="btn btn-xs btn-warning",
                                     icon="pen",
                                     readonly=entry.entry_type.is_locked)
                        }}
                        {{ util.href(cdedblink('core/remove_entry_form', {'entry_id': entry.id}),
                                     label="",
                                     title=gettext("Remove"),
                                     aclass="btn btn-xs btn-danger",
                                     icon="eye-slash",
                                     readonly=entry.entry_type.is_locked)
                        }}
                    </div>
                </div>
                <strong>
                    {{ entry.entry_type.name }}
                </strong>
                {% if entry.concerned_id %}
                    {% trans concerned=util.persona_anchor(personas[entry.concerned_id], icon='user') %}
                         (for {{ concerned }})
                    {% endtrans %}
                {% endif %}
                <br />
                {{ gettext("by") }}
                {% for author_id in entry.active_version.authors %}
                    {% if not loop.first %}, {% endif %}
                    {{ util.persona_anchor(personas[author_id]) }}
                {% endfor %}
                <br />
                <span class="text-muted">
                {% if entry.active_version.length %}
                    {% trans length=entry.active_version.length %}
                        {{ length }} characters.
                    {% endtrans %}
                {% endif %}
                {% if entry.all_versions|length > 1 %}
                    {% trans count=entry.all_versions|length - 1 %}
                        {{ count }} previous versions.
                    {% endtrans %}
                    <br />
                    {% trans mtime=entry.active_version.ctime|datetime(lang=lang),
                             submitted_by=util.persona_anchor(personas[entry.active_version.submitted_by]),
                             ctime=entry.all_versions[0].ctime|datetime(lang=lang),
                             first_submitted_by=util.persona_anchor(personas[entry.all_versions[0].submitted_by]) %}
                        Created at {{ ctime }} by {{ first_submitted_by }};
                        last changed at {{ mtime }} by {{ submitted_by }}.
                    {% endtrans %}
                {% else %}
                    {% trans mtime=entry.active_version.ctime|datetime(lang=lang),
                             submitted_by=util.persona_anchor(personas[entry.active_version.submitted_by]) %}
                        Created at {{ mtime }} by {{ submitted_by }}.
                    {% endtrans %}
                {% endif %}
                </span>
                {% if descriptions.get(entry.active_version.id) %}
                    <hr class="nosp" />
                    <p>

                        {{ descriptions[entry.active_version.id]|md }}
                    </p>
                {% endif %}
                {% if entry.parent %}
                    <hr class="nosp" />
                    ◂
                    {% trans label=util.href("#entry" + entry.parent.id|string, entry.parent.entry_type.name),
                             stamp=entry.parent.active_version.timestamp|date(lang=lang) %}
                        {{ label }} at {{ stamp }}
                    {% endtrans %}
                {% endif %}
                {% if entry.children %}
                    <hr class="nosp" />
                    ▸
                    {% for child in entry.children %}
                        {% if not loop.first %}, {% endif %}
                        {% trans label=util.href("#entry" + child.id|string, child.entry_type.name),
                                 stamp=child.active_version.timestamp|date(lang=lang) %}
                            {{ label }} at {{ stamp }}
                        {% endtrans %}
                    {% endfor %}
                {% endif %}
                {# ToDo: Previous versions? #}
            </div>
        {% elif entry['code'].is_historic %}
            <div id="logentry{{ entry.id }}" class="list-group-item">
                <div class="float-right text-right">
                    {{ entry['ctime']|datetime(lang=lang) }}
                </div>
                <strong>
                    {{ entry['code'].name -}}
                </strong>
                {%- if entry['companion_id'] -%}
                    : {{ util.persona_anchor(personas[entry['companion_id']]) }}
                    {% trans involved=util.persona_anchor(personas[entry['persona_id']], icon='user') %}
                         (for {{ involved }})
                    {% endtrans %}
                {%- elif entry['persona_id'] -%}
                    : {{ util.persona_anchor(personas[entry['persona_id']]) }}
                {% endif %}
                <br />
                {{ gettext("by") }}
                {{ util.persona_anchor(personas[entry['submitted_by']]) }}
                <br />
                <span class="text-muted">
                    {% trans change_note=entry['change_note'] %}
                         {{ change_note }}
                    {% endtrans %}
                </span>
            </div>
        {% endif %}
    {% endfor %}
    </div>
{% endblock %}
