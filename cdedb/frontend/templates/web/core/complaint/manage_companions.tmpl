{% set sidenav_active='complaint_index' %}
{% extends "web/core/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}
{% block scripts %}
    {{ util.cdedb_script('cdedb_helper.js') }}
    {{ util.cdedb_script('cdedb_searchpersona.js') }}
{% endblock %}
{% set jshint='weak' %}

{% block title %}
    {% trans involved=involved_persona|persona_name, title=gettext("Case %s")|format(ambience['case'].id) %}
        Manage Companions for {{ involved }} ({{ title }})
    {% endtrans %}
{% endblock %}

{% block heading %}
    {{ util.context_heading(
        gettext("Manage Companions"),
        involved|persona_name, ambience['case'].involved[involved_id].type_.get_icon(), "",
        gettext("Case %s")|format(ambience['case'].id), 'gavel', "",
    ) }}
{% endblock %}

{% block breadcrumb %}
    {{ super() }}
    {{ util.breadcrumb_link(cdedblink("core/complaint_index"), gettext("Cases")) }}
    {{ util.breadcrumb_link(cdedblink("core/show_case"), gettext("Case %s")|format(ambience['case'].id),
                            icon="gavel") }}
    {{ util.breadcrumb_link(
        "",
        involved_persona|persona_name,
        icon=ambience['case'].involved[involved_id].type_.get_icon(),
        active=True) }}
    {{ util.breadcrumb_link("", gettext("Manage Companions"), active=True) }}
{% endblock %}

{% block content %}
    {% set involved = ambience['case'].involved[involved_id] %}
    <form action="{{ cdedblink('core/add_companions') }}" method="POST"
          id="addcompanionform" class="p">
        {{ util.anti_csrf_token('core/add_companions') }}
        <div class="input-group has-success">
            <span class="input-group-addon">{{ util.make_icon('plus') }}</span>
            {{ util.input_text(type="search", name="companion_ids", anid="input-add-companions",
                               placeholder="DB-XXXX-X,DB-XXXX-X,…",
                               arialabel=gettext("IDs of the new companions")) }}
            <script nonce="{{ csp_nonce }}">
                $('#input-add-involved').cdedbSearchPerson(
                    '{{ cdedblink('core/select_persona') }}', {'kind': 'admin_all_users'},
                    {{ (involved.companions(is_active=None)|list
                        + ambience['case'].adverse_companions(involved.type_)|list
                        + ambience['case'].involved_persona_ids)|list)|tojson }},
                    false, true, "{{ gettext("CdEDB-ID, Name or E-Mail") }}"
                );
            </script>
            <div class="input-group-btn">
                {{ util.input_submit(label=gettext("Add"), icon="user-plus", aclass="btn btn-success ") }}
            </div>
        </div>
        {{ util.output_errors('companion_ids', wrapper=True) }}
    </form>
    {% if companions %}
        <div class="row">
        {% for list in companions.values()|slice(2) %}
            <div class="col-md-6">
            <ul class="slim">
            {% for companion in list %}
                <li class="hide-hover-container clearfix-after">
                    {{ util.strike(util.persona_anchor(companion), companion['id'] not in involved.companions(is_active=False)) }}
                    <div class="list-button-float hide-hover">
                        {% if companion['id'] not in involved.companions(is_active=False) %}
                        <form action="{{ cdedblink('core/withdraw_companion', {'involved_id': involved_id, 'companion_id': companion['id']}) }}"
                              method="POST"
                              id="withdrawcompanionform{{ companion.id }}"
                              class=" display-inline"
                        >
                            {{ util.anti_csrf_token('core/withdraw_companion') }}
                            {{ util.input_submit(
                                label='',
                                aclass="btn btn-xs btn-danger",
                                icon="person-walking-arrow-right",
                                title=gettext("Withdraw %(name)s as companion")|format(name=companion|persona_name)|s
                            ) }}
                        </form>
                        {% else %}
                        <form action="{{ cdedblink('core/reinstate_companion', {'involved_id': involved_id, 'companion_id': companion['id']}) }}"
                              method="POST"
                              id="reinstatecompanionform{{ companion.id }}"
                              class="display-inline"
                        >
                            {{ util.anti_csrf_token('core/reinstate_companion') }}
                            {{ util.input_submit(
                                label='',
                                aclass="btn btn-xs btn-primary",
                                icon="person-walking-arrow-loop-left",
                                title=gettext("Reinstate %(name)s as companion")|format(name=companion|persona_name)|s
                            ) }}
                        </form>
                        {% endif %}
                        <form action="{{ cdedblink('core/remove_companion', {'involved_id': involved_id, 'companion_id': companion['id']}) }}"
                              method="POST"
                              id="removecompanionform{{ companion.id }}"
                              class="display-inline"
                        >
                            {{ util.anti_csrf_token('core/remove_companion') }}
                            {{ util.input_submit(
                                label='',
                                aclass="btn btn-xs btn-danger",
                                icon="trash-alt",
                                title=gettext("Remove %(name)s as companion")|format(name=companion|persona_name)|s
                            ) }}
                        </form>
                    </div>
                </li>
            {% endfor %}
            </ul>
            </div>
        {% endfor %}
        </div>
    {% endif %}
{% endblock %}
