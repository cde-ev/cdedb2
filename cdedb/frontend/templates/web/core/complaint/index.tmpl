{% set sidenav_active='complaint_index' %}
{% extends "web/core/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}
{% import "web/core/complaint/generic.tmpl" as generic_complaint with context %}
{% block scripts %}
    {{ util.cdedb_script('cdedb_searchpersona.js') }}
    {{ util.cdedb_script('cdedb_multiselect.js') }}
{% endblock %}
{% set jshint="weak" %}
{% block title %}
    {% trans %}
    	Case Archive
    {% endtrans %}
{% endblock %}

{% block breadcrumb %}
    {{ super() }}
    {{ util.breadcrumb_link(cdedblink("core/complaint_index"), gettext("Cases"), active=True) }}
{% endblock %}


{% block content %}
    <div class="p button-par">
        {{ util.href(cdedblink('core/create_case'), gettext("Create Case"),
                     aclass="btn btn-sm btn-success", icon="plus") }}
        {% if cases %}
            {{ util.href("#casesearchform", gettext("Go to Search."), aclass="btn btn-default btn-sm", icon="arrow-down") }}
        {% endif %}
    </div>

    {% if values['is_search'] %}
        {% if cases %}
            <h2 id="result-count">
                {% trans %}Result{% endtrans %}
                <small>
                {% trans count=count %}
                    {{ count }} Cases found
                {% endtrans %}
                </small>
            </h2>
            <div id="result" class="list-group list-group-hover list-group-condensed">
                {% for case in cases.values() %}
                    <div id="case{{ case.id }}" class="list-group-item">
                        <div class="row">
                            <div class="col-md-4 float-right text-right">
                                {% if case.start_date or case.end_date %}
                                    {{ case.start_date|date(lang=lang) }}–{{ case.end_date|date(lang=lang) }}
                                {% endif %}
                           </div>
                            <div class="col-md-2">
                                {{- util.href(
                                    cdedblink("core/show_case", {'case_id': case.id}),
                                    gettext("Case %s")|s|format(case.id)
                                ) }}
                                {{ generic_complaint.case_status_flags(case) }}
                            </div>
                            <div class="col-md-6">
                                {{ gettext(case.kind|string) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-10 col-md-offset-2">
                            <hr class="nosp" />
                                {% for involvement_type, involved_ids in case.involved_by_type.items() %}
                                    {% if not involvement_type == enums["ComplaintInvolvementType"].withheld %}
                                        {% if not loop.first %}
                                            <br />
                                        {% endif %}
                                        <span class="text-muted">
                                        {{ util.make_icon(involvement_type.get_icon(), title=gettext(involvement_type|string)) }}
                                        <span aria-hidden="true">{{ gettext(involvement_type.shortname) }}</span>:
                                        </span>
                                        {% for involved_id in involved_ids %}
                                            {% set persona_id = case.involved[involved_id].persona_id %}
                                            {{ util.persona_anchor(personas[persona_id]) -}}
                                            {%- if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                {% endfor %}
                                <hr class="nosp" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-10 col-md-offset-2">
                                {{ case.summary|md }}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <h2 id="result-count">
                {% trans %}Result{% endtrans %}
            </h2>
            <p class="text-muted">
                {% trans %}
                    No cases found.
                {% endtrans %}
            </p>
        {% endif %}
    {% endif %}

    <form action="{{ cdedblink('core/complaint_index') }}" method="GET" id="complaintsearchform" class="form-horizontal">
        {{ util.input_hidden(name="is_search", value=True) }}
        <div class="panel panel-primary mosp">
            <div class="panel-heading">
                <h2 class="panel-title">{{ util.make_icon('search') }} {% trans %}Search Mask{% endtrans %}</h2>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <label class="control-label col-sm-2" for="input-case_summary">
                                {% trans %}Summary{% endtrans %}
                            </label>
                            <div class="col-sm-10">
                                {% call util.output_errors("qval_cases.summary", wrapper=True) %}
                                    {{ util.input_text(name="qval_cases.summary", anid="input-case_summary") }}
                                {% endcall %}
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-sm-2" for="input-case_kind">
                                {% trans %}Kind{% endtrans %}
                            </label>
                            <div class="col-sm-10">
                                {% call util.output_errors("qval_cases.kind", wrapper=True) %}
                                    {{ util.input_multi_select(
                                            name="qval_cases.kind", anid="input-case_kind", selectize=true,
                                            entries=enums["ComplaintKind"]|enum_entries(processing=gettext, intval=True),
                                            nulloption=nbsp, attributes="size=" + (enums["ComplaintKind"]|length + 1)|string) }}
                                {% endcall %}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        {{ util.form_input_select(name="qval_status.is_confirmed",
                                                  label=gettext("is confirmed"), aclass="input-sm",
                                                  entries=[(True, gettext("Yes")), (False, gettext("No"))],
                                                  nulloption=nbsp) }}
                        {{ util.form_input_text(name="qval_cases.end_date", label=gettext("Occurred after"),
                                                aclass="input-sm", type="date") }}
                        {{ util.form_input_text(name="qval_cases.start_date", label=gettext("Occurred before"),
                                                aclass="input-sm", type="date") }}
                    </div>
                    <div class="col-sm-6">
                        {{ util.form_input_select(name="qval_status.is_closed",
                                                  label=gettext("is closed_[[short]]"), aclass="input-sm",
                                                  entries=[(True, gettext("Yes")), (False, gettext("No"))],
                                                  nulloption=nbsp) }}
                        {{ util.form_input_text(name="last_entry_after", label=gettext("Last entry after"),
                                                aclass="input-sm", type="datetime-local") }}
                        {{ util.form_input_text(name="last_entry_before", label=gettext("Last entry before"),
                                                aclass="input-sm", type="datetime-local") }}
                    </div>
                </div>
                <hr class="panel-primary nosp" style="margin-bottom: 15px;" />
                <div class="row">
                    <div class="col-sm-6">
                        {{ util.form_input_text(type="search", name="qval_involved.persona_id", anid="input-involved_id",
                                                label=gettext("Involved"), aclass="input-sm") }}
                        <script nonce="{{ csp_nonce }}">
                            $('#input-involved_id').cdedbSearchPerson(
                                '{{ cdedblink('core/select_persona') }}', {'kind' : 'admin_all_users'},
                                [{{ user.persona_id }}], false, false, "{{ gettext("ID, name, email") }}"
                            );
                        </script>
                        {{ util.form_input_multi_select(
                                 name="qval_involved.type_", label=gettext("Involvement"),
                                 anid="input-type_", aclass="input-sm", selectize=true,
                                 entries=enums["ComplaintInvolvementType"]|enum_entries(processing=gettext, intval=True),
                                 nulloption=nbsp, attributes="size=" + (enums["ComplaintInvolvementType"]|length + 1)|string) }}
                        {{ util.form_input_select(name="qval_involved.is_informed",
                                                  label=gettext("is informed"), aclass="input-sm",
                                                  entries=[(True, gettext("Yes")), (False, gettext("No"))],
                                                  nulloption=nbsp) }}
                    </div>
                    <div class="col-sm-6">
                        {{ util.form_input_text(type="search", name="qval_companion.companion_persona_id", anid="input-companion_id",
                                                label=gettext("Companion"), aclass="input-sm") }}
                        <script nonce="{{ csp_nonce }}">
                            $('#input-companion_id').cdedbSearchPerson(
                                '{{ cdedblink('core/select_persona') }}', {'kind' : 'admin_all_users'},
                                [], false, false, "{{ gettext("ID, name, email") }}"
                            );
                        </script>
                        {{ util.form_input_select(name="qval_companion.is_withdrawn",
                                                   label=gettext("is withdrawn"), aclass="input-sm",
                                                   entries=[(True, gettext("Yes")), (False, gettext("No"))],
                                                   nulloption=nbsp) }}
                    </div>
                </div>
            </div>
            <div class="panel-footer text-right">
                {{ util.input_submit(gettext("Search"), icon='search') }}
            </div>
        </div>
    </form>

{% endblock %}
