{% extends "web/core/base.tmpl" %}
{% import "web/util.tmpl" as util with context %}
{% block title %}
    {% trans name=ambience['persona']|persona_name %}
        {{ name }} – Mailinglist Data
    {% endtrans %}
{% endblock %}
{% block breadcrumb %}
    {{ super() }}
    {{ util.breadcrumb_link(show_user_link(user, ambience['persona']['id']), ambience['persona']|persona_name,
                            icon="user") }}
    {{ util.breadcrumb_link(cdedblink("core/show_user_mailinglists"), gettext("Show Mailinglist Data"), active=True) }}
{% endblock %}

{% block heading %}
    {{ util.context_heading(gettext("Mailinglist Data"), ambience['persona']|persona_name,
                            'user', gettext("User")) }}
{% endblock %}

{% block content %}
    {{ util.h(n_("Global information"), level=3, underline=True) }}
    <dl class="dl-horizontal">
        <dt title="{% trans %}Name{% endtrans %}">
            {% trans %}Name{% endtrans %}
        </dt>
        <dd>
            {{ ambience['persona']|persona_name(with_titles=True) }}
        </dd>
        <dt title="{% trans %}CdEDB-ID{% endtrans %}">
            {% trans %}CdEDB-ID{% endtrans %}
        </dt>
        <dd id="cdedb-id">
            {{ ambience['persona']['id']|cdedbid }}
        </dd>
        <dt title="{% trans %}E-Mail{% endtrans %}">
            {% trans %}E-Mail{% endtrans %}
        </dt>
        <dd id="contact-email">
            {{ util.username_mailto(ambience['persona']) }}
        </dd>
    </dl>

    {{ util.h(n_("Mailinglist Subscriptions"), level=3, underline=True) }}
    <p>
        {% trans %}
            This lists all mailinglists this user is related to.
            In particular, this includes lists they are or have recently been subscribed to,
            as well as pending subscriptions and blocks.
        {% endtrans %}
    </p>
    {% for group, mailinglists in grouped.items() %}
        {{ util.h(group|string, level=4, underline=true) }}
        <div class="row">
            {% for list_slice in mailinglists|slice(2) %}
                <ul class="styleless col-md-6 {% if not loop.last %}nosp{% endif %}">
                    {% for ml in list_slice %}
                        {% set state = subscriptions.get(ml.id) %}
                        {% set trouble = state in enums["SubscriptionState"].subscribing_states() and not receiving[ml.id] %}
                        {% if is_relevant_admin(mailinglist_id=ml.id) or ml.id in user.moderator %}
                            {% set link = "ml/management" %}
                        {% else %}
                            {% set link = "ml/show_mailinglist" %}
                        {% endif %}
                        <li class="hide-hover-container clearfix-after{% if not ml['is_active'] or trouble %} text-muted{% endif %}">
                            {{ util.state_checkbox(state) }}
                            {% if trouble %}
                                {{ util.make_icon('exclamation-triangle', aclass="text-danger",
                                        title=gettext("Subscribed with defect address, will not receive any mails.")) }}
                            {% endif %}
                            {{ util.href(cdedblink(link, {'mailinglist_id': ml.id}), ml["title"]) }}
                        {% if state == enums["SubscriptionState"].subscription_override %}
                            {{ gettext("(override)") }}
                        {% elif state == enums["SubscriptionState"].unsubscription_override %}
                            {{ gettext("(blocked)") }}
                        {% endif %}
                        {% if ml["address"] %}
                            <br />
                            <span class="far fa-circle dummy"></span>
                            {% trans %}E-Mail:{% endtrans %}
                            {{ util.username_mailto(ambience['persona'], email=ml["address"]) }}
                        {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endfor %}
        </div>
    {% endfor %}

    {{ util.h(n_("Moderated Mailinglists"), level=3, underline=True) }}
    {% for group, mailinglists in grouped_moderated.items() %}
        {{ util.h(group|string, level=4, underline=true) }}
        <div class="row">
            {% for list_slice in mailinglists|slice(2) %}
                <div class="col-md-6">
                    <ul class="{% if not loop.last %}nosp{% endif %}">
                        {% for ml in list_slice %}
                            <li class="{% if not ml.is_active %}text-muted {% endif %}">
                                {{ util.href(cdedblink("ml/show_mailinglist", {"mailinglist_id": ml.id}), ml.title) }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}
