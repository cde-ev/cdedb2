{% macro input_multi_select(name, entries, selectize=False, readonly=False, actualreadonly=False, anid=none,
        aclass='form-control', nulloption=none, arialabel=none, attributes="", sort=False, enforce_required=True) %}
    {% set anid = anid or 'inputmultiselect-' + name %}
    <select multiple {{ dict(
        name=name if not actualreadonly else ("readonly" + name),
        id=anid,
        class=aclass,
        disabled="disabled" if readonly or actualreadonly,
        required="required" if name in mandatory_fields and enforce_required,
