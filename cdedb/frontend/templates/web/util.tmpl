{% macro _select_options(options, former_value, defaultvalue) %}
    {% for value, label in options %}
        <option value="{{ value }}"
            {%- if former_value == value|string or (former_value == "" and defaultvalue|string == value|string) %}
                selected="selected"
            {% endif %}>
